local function MiniFling(target)
    if not target or not target.Character then
        Notify("No valid character of the target player.")
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = humanoid and humanoid.RootPart
    local targetCharacter = target.Character
    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetHumanoid and targetHumanoid.RootPart
    local targetHead = targetCharacter:FindFirstChild("Head")

    if not character or not humanoid or not root or not targetHumanoid or not targetRoot then
        Notify("Required fling objects were not found.")
        return
    end

    local oldPosition = root.CFrame
    local oldDestroyHeight = workspace.FallenPartsDestroyHeight

    workspace.FallenPartsDestroyHeight = 0 / 0

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "DarkHub_FlingVelocity"
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(9e8, 9e8, 9e8)
    bodyVelocity.Parent = root

    local targetPart = targetHead or targetRoot

    local started = tick()

    while tick() - started < 2 and targetPart.Parent and root.Parent and targetHumanoid.Health > 0 do
        if targetPart.Velocity.Magnitude < 50 then
            local velocity = targetHumanoid.MoveDirection * targetHumanoid.WalkSpeed / 1.25

            local positions = {
                CFrame.new(0, 1.5, 0),
                CFrame.new(0, -1.5, 0),
                CFrame.new(2.25, 1.5, -2.25),
                CFrame.new(-2.25, -1.5, 2.25)
            }

            for _, offset in ipairs(positions) do
                if not targetPart.Parent then
                    break
                end

                root.CFrame = CFrame.new(targetPart.Position) * offset + velocity
                root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
                root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)

                task.wait()
            end
        else
            root.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1.5, 0))
            root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)

            task.wait()
        end
    end

    bodyVelocity:Destroy()

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = humanoid

    for _ = 1, 30 do
        if not root.Parent then
            break
        end

        root.CFrame = oldPosition * CFrame.new(0, 0.5, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

        task.wait()

        if (root.Position - oldPosition.Position).Magnitude < 25 then
            break
        end
    end

    workspace.FallenPartsDestroyHeight = oldDestroyHeight
end

local function ToggleAntiFling(value)
    antiFlingEnabled = value

    if antiFlingConnection then
        antiFlingConnection:Disconnect()
        antiFlingConnection = nil
    end

    if value then
        antiFlingConnection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end

            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChild("Humanoid")

            if rootPart and humanoid then
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero

                for _, constraint in ipairs(rootPart:GetChildren()) do
                    if constraint:IsA("BodyVelocity") or constraint:IsA("BodyPosition") or constraint:IsA("BodyGyro") or constraint:IsA("BodyAngularVelocity") then
                        constraint:Destroy()
                    end
                end
            end
        end)
        Notify("Anti Fling enabled")
    else
        Notify("Anti Fling disabled")
    end
end

local function SetSpeed(value)
    speedMultiplier = math.clamp(value, 1, maxSpeedLimit)

    if speedUpdateConnection then
        speedUpdateConnection:Disconnect()
    end

    speedUpdateConnection = RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end

        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            originalWalkSpeed = humanoid.WalkSpeed
            humanoid.WalkSpeed = originalWalkSpeed * speedMultiplier
        end
    end)
end

local function TogglePlayerESP(value)
    playerESP = value

    if value then
        if not FindMurderer() and not FindSheriff() then
            Notify("No roles yet. Waiting for roles.")

            task.spawn(function()
                repeat
                    task.wait(1)
                until not playerESP or FindSheriff() or FindMurderer()

                if playerESP then
                    ReloadESP()
                end
            end)
        else
            ReloadESP()
        end
    else
        ESPContainer:RemoveGroup("players")
    end
end

