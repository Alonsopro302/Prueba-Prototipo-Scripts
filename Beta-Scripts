local function GetItem(Name, Folder)
    local C = LocalPlayer.Character
    if not C then return end
    local Org = C.HumanoidRootPart.CFrame
    local function Uns()
        local H = C:FindFirstChild("Humanoid")
        if H then H.Sit = false end
    end
    local S = workspace.Prison_ITEMS[Folder]
    local It = S:FindFirstChild(Name)
    if It and It:FindFirstChild("ITEMPICKUP") then
        local P = It:FindFirstChildWhichIsA("BasePart")
        while not P do task.wait() P = It:FindFirstChildWhichIsA("BasePart") end
        repeat
            Uns()
            pcall(function() C.HumanoidRootPart.CFrame = CFrame.new(P.Position) end)
            task.spawn(function() pcall(function() workspace.Remote.ItemHandler:InvokeServer(P) end) end)
            task.wait()
        until LocalPlayer.Backpack:FindFirstChild(Name) or C:FindFirstChild(Name)
    end
    pcall(function() C.HumanoidRootPart.CFrame = Org end)
end
