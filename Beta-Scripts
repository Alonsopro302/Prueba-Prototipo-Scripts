local function FindNearestPlayer()
    local nearestPlayer
    local shortestDistance = math.huge

    local character = LocalPlayer.Character
    local localRoot = character and character:FindFirstChild("HumanoidRootPart")

    if not localRoot then
        return nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")

            if root then
                local distance = (localRoot.Position - root.Position).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestPlayer = player
                end
            end
        end
    end

    return nearestPlayer
end

local function GetClosestModelToPlayer(player, models)
    if not player.Character then
        return nil
    end

    local root = player.Character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local closestModel
    local closestDistance = math.huge

    for _, model in ipairs(models) do
        if model:IsA("Model") or model:IsA("BasePart") then
            local position = model:IsA("Model") and model:GetPivot().Position or model.Position
            local distance = (position - root.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestModel = model
            end
        end
    end

    return closestModel
end

local function GetPredictedPosition(player, offset)
    if not player or not player.Character then
        return Vector3.zero
    end

    local character = player.Character
    local playerHRP = character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    local playerHumanoid = character:FindFirstChild("Humanoid")

    if not playerHRP or not playerHumanoid then
        return Vector3.zero
    end

    if predictionAIEngine and not predictionOngoing and not predictionCooldown then
        local network = getgenv().DarkHubNetwork

        if network and type(network.predictPos) == "function" then
            local localCharacter = LocalPlayer.Character
            local localTorso = localCharacter and (localCharacter:FindFirstChild("UpperTorso") or localCharacter:FindFirstChild("HumanoidRootPart"))

            if localTorso and (playerHRP.Position - localTorso.Position).Magnitude > 20 then
                predictionCooldown = true
                predictionOngoing = true

                local success, predictedPosition = pcall(function()
                    return network.predictPos(player)
                end)

                predictionOngoing = false

                task.delay(5, function()
                    predictionCooldown = false
                end)

                if success and typeof(predictedPosition) == "Vector3" then
                    return predictedPosition
                end
            end
        end
    end

    local velocity = playerHRP.AssemblyLinearVelocity
    local moveDirection = playerHumanoid.MoveDirection

    local predictedPosition = playerHRP.Position
        + velocity * Vector3.new(0.75, 0.5, 0.75) * (offset / 15)
        + moveDirection * offset

    predictedPosition = predictedPosition * (
        ((LocalPlayer:GetNetworkPing() * 1000) * ((offsetToPingMult - 1) * 0.01)) + 1
    )

    return predictedPosition
end

local function EquipTool(toolName)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not humanoid then
        Notify("Your character is invalid.")
        return false
    end

    if character:FindFirstChild(toolName) then
        return true
    end

    local tool = LocalPlayer.Backpack:FindFirstChild(toolName)

    if not tool then
        Notify("You don't have the " .. toolName .. ".")
        return false
    end

    humanoid:EquipTool(tool)

    return character:FindFirstChild(toolName) ~= nil
end

local function ShootMurderer()
    if FindSheriff() ~= LocalPlayer then
        Notify("You're not sheriff/hero.")
        return
    end

    local murderer = FindMurderer() or FindSheriffNotMe()

    if not murderer or not murderer.Character then
        Notify("No murderer or sheriff to shoot.")
        return
    end

    if not EquipTool("Gun") then
        return
    end

    local character = LocalPlayer.Character
    local rightHand = character and character:FindFirstChild("RightHand")
    local murdererHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local gun = character and character:FindFirstChild("Gun")
    local shootRemote = gun and gun:FindFirstChild("Shoot")

    if not rightHand or not murdererHRP or not shootRemote then
        Notify("Required gun objects were not found.")
        return
    end

    local predictedPosition = GetPredictedPosition(murderer, shootOffset)

    local args

    if instakillshoot then
        args = {
            CFrame.new(murdererHRP.Position + Vector3.new(0, 1, 0)),
            CFrame.new(murdererHRP.Position)
        }
    else
        args = {
            CFrame.new(rightHand.Position),
            CFrame.new(predictedPosition)
        }
    end

    shootRemote:FireServer(unpack(args))
end

local function KnifeThrow(silent)
    if FindMurderer() ~= LocalPlayer then
        if not silent then
            Notify("You're not murderer.")
        end

        return
    end

    if not EquipTool("Knife") then
        return
    end

    local nearestPlayer = FindNearestPlayer()

    if not nearestPlayer or not nearestPlayer.Character then
        if not silent then
            Notify("Can't find a player.")
        end

        return
    end

    local character = LocalPlayer.Character
    local rightHand = character and character:FindFirstChild("RightHand")
    local nearestHRP = nearestPlayer.Character:FindFirstChild("HumanoidRootPart")
    local knife = character and character:FindFirstChild("Knife")
    local events = knife and knife:FindFirstChild("Events")
    local remote = events and events:FindFirstChild("KnifeThrown")

    if not rightHand or not nearestHRP or not remote then
        if not silent then
            Notify("Required knife objects were not found.")
        end

        return
    end

    local args = {
        CFrame.new(rightHand.Position),
        CFrame.new(GetPredictedPosition(nearestPlayer, shootOffset + 1))
    }

    if spawnAtPlayer then
        args[1] = CFrame.new(nearestHRP.Position + nearestHRP.CFrame.LookVector * 5)
    end

    remote:FireServer(unpack(args))
end

