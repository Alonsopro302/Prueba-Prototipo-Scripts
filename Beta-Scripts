-- AutoFarm compacto
local FarmSpeed = 40
local FarmConn
local function AutoFarmToggle(state)
    if FarmConn then FarmConn:Disconnect() end
    if not state then Notify("AutoFarm desactivado") return end
    Notify("AutoFarm activado")
    FarmConn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        local hrp = c.HumanoidRootPart
        local map = Workspace:FindFirstChildWhichIsA("Model",true,function(x) return x:FindFirstChild("CoinContainer") end)
        if not map then return end
        local coins = map:FindFirstChild("CoinContainer"):GetChildren() if #coins==0 then return end
        local best,bestD = nil,math.huge
        local myPos = hrp.Position
        for _,coin in ipairs(coins) do
            if coin:IsA("BasePart") or coin:IsA("Model") then
                local p = coin:IsA("Model") and coin:GetPivot().Position or coin.Position
                local d = (myPos - p).Magnitude
                if d<bestD then bestD=d best=coin end
            end
        end
        if best then
            local dest = best:IsA("Model") and best:GetPivot() or best.Position
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(dest), math.clamp(FarmSpeed/100,0.06,0.82))
        end
    end)
end

