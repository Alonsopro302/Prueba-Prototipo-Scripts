local function AlternarESPJugadores(valor)
    playerESP=valor
    if valor then
        if not EncontrarAsesino() and not EncontrarSheriff() then
            Notify("Esperando asignacion de roles...")
            task.spawn(function()
                repeat task.wait(1) until not playerESP or EncontrarSheriff() or EncontrarAsesino()
                if playerESP then RecargarESP() end
            end)
        else RecargarESP() end
    else ESPContainer:EliminarGrupo("jugadores") end
end

local function AlternarESPArmas(valor)
    gunDropESP=valor
    if not valor then ESPContainer:EliminarGrupo("armas"); return end
    local mapaAct = ObtenerMapa()
    if not mapaAct then return end
    local armaSuelta = mapaAct:FindFirstChild("GunDrop")
    if armaSuelta then
        ESPContainer:Agregar(armaSuelta,{ColorResaltado=Color3.new(0.95,1,0.07),MostrarFlecha=true,DistanciaMinimaFlecha=999999,TextoEtiqueta="ARMA EN SUELO",MostrarEtiqueta=true,NombreGrupo="armas"})
        Notify("Arma detectada - resaltada amarillo")
    end
end

local function AlternarESPTrampas(valor)
    trapDetection=valor
    if not valor then ESPContainer:EliminarGrupo("trampas"); return end
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name=="Trap" and obj.Parent and (obj.Parent:IsA("Folder") or obj.Parent:IsA("Model")) then
            if obj:IsA("BasePart") then obj.Transparency=0 end
            ESPContainer:Agregar(obj,{ColorResaltado=Color3.new(1,0,0),MostrarFlecha=false,MostrarEtiqueta=true,TextoEtiqueta="TRAMPA",NombreGrupo="trampas"})
        end
    end
end

local function AlternarTiempoRonda(valor)
    if timerTask then task.cancel(timerTask); timerTask=nil end
    if timerText then timerText:Destroy(); timerText=nil end
    if not valor then return end
    timerText=Instance.new("TextLabel")
    timerText.Name="ChitukHub_TiempoRonda"
    timerText.Parent=game:GetService("CoreGui")
    timerText.BackgroundTransparency=1
    timerText.TextColor3=Color3.new(1,1,1)
    timerText.TextScaled=true
    timerText.AnchorPoint=Vector2.new(0.5,0.5)
    timerText.Position=UDim2.fromScale(0.5,0.15)
    timerText.Size=UDim2.fromOffset(200,35)
    timerText.Font=Enum.Font.Montserrat
    timerTask=task.spawn(function()
        while timerText do
            task.wait(0.5)
            local relojRonda=Workspace:FindFirstChild("RoundTimerPart")
            if relojRonda then
                local tiempoAct = relojRonda:GetAttribute("Time")
                if type(tiempoAct)=="number" then
                    if tiempoAct==-1 then timerText.Text="" else
                        local minRonda=math.floor(tiempoAct/60)
                        local segRonda=tiempoAct%60
                        timerText.Text=string.format("%dm %ds",minRonda,segRonda)
                    end
                end
            end
        end
    end)
end

local function EnviarRolesChat()
    local canalesChat=TextChatService:WaitForChild("TextChannels"):GetChildren()
    local asesinoChat=EncontrarAsesino()
    local sheriffChat=EncontrarSheriff()
    local nomAsesino=asesinoChat and asesinoChat.Name or "-"
    local nomSheriff=sheriffChat and sheriffChat.Name or "-"
    local mensajeChat=string.format("Asesino: %s | Sheriff: %s | Chituk Hub",nomAsesino,nomSheriff)
    for _,canal in ipairs(canalesChat) do
        if canal:IsA("TextChannel") and canal.Name~="RBXSystem" then pcall(function() canal:SendAsync(mensajeChat) end) end
    end
end

local function AlternarAuraMuerte(valor)
    if killAuraConnection then killAuraConnection:Disconnect(); killAuraConnection=nil end
    if not valor then return end
    killAuraConnection=RunService.Heartbeat:Connect(function()
        if EncontrarAsesino()~=LocalPlayer then return end
        local persAura=LocalPlayer.Character
        local raizAura=persAura and persAura:FindFirstChild("HumanoidRootPart")
        local armaAura=persAura and persAura:FindFirstChild("Knife")
        local eventoAtaque=armaAura and armaAura:FindFirstChild("Stab")
        if not raizAura or not eventoAtaque then return end
        for _,jugAura in ipairs(Players:GetPlayers()) do
            if jugAura~=LocalPlayer and jugAura.Character then
                local raizJugAura=jugAura.Character:FindFirstChild("HumanoidRootPart")
                if raizJugAura and (raizAura.Position - raizJugAura.Position).Magnitude <7 then
                    raizJugAura.Anchored=true
                    raizJugAura.CFrame=raizAura.CFrame + raizAura.CFrame.LookVector*2
                    task.wait(0.1)
                    if eventoAtaque:IsA("RemoteEvent") then eventoAtaque:FireServer("Slash") end
                    break
                end
            end
        end
    end)
end

local function MatarMasCercano()
    if EncontrarAsesino()~=LocalPlayer then Notify("Solo para Asesino"); return end
    if not EquiparHerramienta("Knife") then return end
    local victimaCerc=EncontrarJugadorCercano()
    if not victimaCerc or not victimaCerc.Character then Notify("Sin victima cercana"); return end
    local persCerc=LocalPlayer.Character
    local raizCerc=persCerc and persCerc:FindFirstChild("HumanoidRootPart")
    local raizVict=victimaCerc.Character:FindFirstChild("HumanoidRootPart")
    local armaCerc=persCerc:FindFirstChild("Knife")
    local eventoCerc=armaCerc and armaCerc:FindFirstChild("Stab")
    if not raizCerc or not raizVict or not eventoCerc then Notify("Elementos ataque incompletos"); return end
    raizVict.Anchored=true
    raizVict.CFrame=raizCerc.CFrame + raizCerc.CFrame.LookVector*2
    task.wait(0.1)
    eventoCerc:FireServer("Slash")
end

local function ModoDios()
    local camaraDios=Workspace.CurrentCamera
    local persDios=LocalPlayer.Character
    local humDios=persDios and persDios:FindFirstChildOfClass("Humanoid")
    if not camaraDios or not persDios or not humDios then Notify("Personaje invalido"); return end
    local posCamAnt=camaraDios.CFrame
    local clonHum=humDios:Clone()
    clonHum.Parent=persDios
    LocalPlayer.Character=nil
    humDios:Destroy()
    LocalPlayer.Character=persDios
    camaraDios.CameraSubject=clonHum
    camaraDios.CFrame=posCamAnt
    clonHum:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
    clonHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    clonHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
    clonHum.BreakJointsOnDeath=true
    clonHum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    local animPers=persDios:FindFirstChild("Animate")
    if animPers then animPers.Disabled=true; task.wait(); animPers.Disabled=false end
    clonHum.Health=clonHum.MaxHealth
end

