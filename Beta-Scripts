local function getClosestCoin()
local map = getMap()
local container = map and map:FindFirstChild("CoinContainer")
local character = LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if not container or not root then
return
end

local closest
local closestDistance = math.huge

for _, coin in ipairs(container:GetChildren()) do
local pivot

if coin:IsA("Model") then
pivot = coin:GetPivot().Position
elseif coin:IsA("BasePart") then
pivot = coin.Position
end

if pivot then
local distance = (root.Position - pivot).Magnitude

if distance < closestDistance then
closestDistance = distance
closest = coin
end
end
end

return closest
end

local function toggleCoinAutoCollect(value)
coinAutoCollect = value

if coinCollectTask then
task.cancel(coinCollectTask)
coinCollectTask = nil
end

if not value then
return
end

coinCollectTask = task.spawn(function()
while coinAutoCollect do
task.wait(0.1)

local map = getMap()
local container = map and map:FindFirstChild("CoinContainer")

if container and #container:GetChildren() > 1 then
local coin = getClosestCoin()
local character = LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if coin and root then
local targetCFrame = coin:IsA("Model") and coin:GetPivot() or coin.CFrame
local distance = (root.Position - targetCFrame.Position).Magnitude

local tween = TweenService:Create(root, TweenInfo.new(distance * 0.05, Enum.EasingStyle.Linear), {
CFrame = targetCFrame
})

tween:Play()
tween.Completed:Wait()

if coin and coin.Parent then
coin:Destroy()
end
end
end
end
end)
end

