    end
    Notify("Recoleccion de monedas: Activada")
    coinLoop = RunService.Heartbeat:Connect(function()
        local chr = LocalPlayer.Character
        if not chr then return end
        local root = chr:FindFirstChild("HumanoidRootPart")
        local hum = chr:FindFirstChild("Humanoid")
        if not root or not hum or not root.Parent then return end
        local map = GetMap()
        if not map then return end
        local container = map:FindFirstChild("CoinContainer")
        if not container or not container:IsDescendantOf(workspace) then return end
        local coins = container:GetChildren()
        if #coins < 1 then return end
        local playerPos = root.Position
        local closest, minDist = nil, math.huge
        for _, coin in ipairs(coins) do
            if coin:IsA("BasePart") or coin:IsA("Model") then
                local coinPos = coin:IsA("Model") and coin:GetPivot().Position or coin.Position
                local dist = (playerPos - coinPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = coin
                end
            end
        end
        if closest then
            local goalPos = closest:IsA("Model") and closest:GetPivot().Position or closest.Position
            local speedFactor = math.clamp(coinSpeedMultiplier / 50, 0.15, 3)
            local direction = (goalPos - playerPos).Unit
            local moveSpeed = math.min(minDist, speedFactor * 25)
            if minDist > 1.5 then
                root.CFrame = root.CFrame:Lerp(CFrame.new(goalPos), math.clamp(speedFactor * 0.12, 0.05, 0.85))
                root.AssemblyLinearVelocity = direction * moveSpeed
                root.AssemblyAngularVelocity = Vector3.zero
            else
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)
end
local function ToggleRoundTimer(v)
    if timerTask then task.cancel(timerTask); timerTask=nil end
    if timerText then timerText:Destroy(); timerText=nil end
    if not v then return end
    timerText=Instance.new("TextLabel")
    timerText.Name="ChitukHub_Cronometro"
    timerText.Parent=game:GetService("CoreGui")
    timerText.BackgroundTransparency=1
    timerText.TextColor3=Color3.new(1,1,1)
    timerText.TextScaled=true
    timerText.AnchorPoint=Vector2.new(0.5,0.5)
    timerText.Position=UDim2.fromScale(0.5,0.15)
    timerText.Size=UDim2.fromOffset(200,35)
    timerText.Font=Enum.Font.Montserrat
    timerTask=task.spawn(function()
        while timerText do
            task.wait(0.5)
            local rt=workspace:FindFirstChild("RoundTimerPart")
            if rt then
                local t=rt:GetAttribute("Time")
                if type(t)=="number" then
                    if t==-1 then timerText.Text="" else
                        local m=math.floor(t/60)
                        local s=t%60
                        timerText.Text=string.format("%dm %ds",m,s)
                    end
                end
            end
        end
    end)
end
