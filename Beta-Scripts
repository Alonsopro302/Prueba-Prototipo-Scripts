VisualSection:CreateButton({
    Name = "Skin Guns",
    Callback = function()
        local backpackContainer = game:GetService("Players").LocalPlayer
        local option = backpackContainer:FindFirstChildOfClass("Backpack") or backpackContainer:WaitForChild("Backpack")
        local data = {"AK-47", "M4A1", "Remington 870", "M9"}
        
        local function updateColor(updateColorFlag)
            local updateColorNumber = 0
            while updateColorFlag and updateColorFlag.Parent do
                updateColorNumber = (updateColorNumber + 0.01) % 1
                local descendantColor = Color3.fromHSV(updateColorNumber, 1, 1)
                for _, descendant in ipairs(updateColorFlag:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        descendant.Color = descendantColor
                    end
                end
                wait(0.1)
            end
        end
        
        for _, item in ipairs(data) do
            local flag = option:FindFirstChild(item) or backpackContainer.Character:FindFirstChild(item)
            if flag then
                spawn(function()
                    updateColor(flag)
                end)
            end
        end
    end
})

