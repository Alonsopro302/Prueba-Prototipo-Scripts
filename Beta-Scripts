                                if shootEvent then
                                    shootEvent:FireServer(shootCFrame, targetCFrame)
                                end
                            end)
                            task.wait(0.8)
                        end
                    end)
                end
            end)
            table.insert(autoShootVisibleConnections, charAddedConn)
        else
            autoShootVisibleActive = false
            if autoShootVisibleLoop then
                task.cancel(autoShootVisibleLoop)
                autoShootVisibleLoop = nil
            end
            for _, conn in pairs(autoShootVisibleConnections) do
                pcall(function() conn:Disconnect() end)
            end
            autoShootVisibleConnections = {}
            Notify("Auto Disparar Visible: Desactivado")
        end
    end
})

