end

local function checkAntiTase()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        local H = Char.Humanoid
        if H.WalkSpeed == 0 then
            H.WalkSpeed = 16
            H.PlatformStand = false
        end
    end
end

local function stopAllSounds()
    while getgenv().stopSounds do
        for _, v in ipairs(game:GetDescendants()) do
            if v:IsA("Sound") then v:Stop() end
        end
        task.wait()
    end
end

local function playAllSounds()
    while getgenv().spamSounds do
        for _, v in ipairs(game:GetDescendants()) do
            if v:IsA("Sound") then v:Play() end
        end
        task.wait()
    end
end

local function killAuraLoop()
    while getgenv().killAuraEnabled do
        local Char = LocalPlayer.Character
        if Char and Char:FindFirstChild("HumanoidRootPart") then
            local MyPos = Char.HumanoidRootPart.Position
            for _, P in ipairs(Players:GetPlayers()) do
                if P ~= LocalPlayer and P.Character and P.Character:FindFirstChild("HumanoidRootPart") then
                    local TPos = P.Character.HumanoidRootPart.Position
                    if (MyPos - TPos).Magnitude <= 17 then
                        for _ = 1, 25 do
                            pcall(function() game.ReplicatedStorage.meleeEvent:FireServer(P) end)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function getSilentTarget()
    local minDist = math.huge
    local Target = nil
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer and P.Team ~= LocalPlayer.Team and P.Character then
            local Part = P.Character:FindFirstChild(getgenv().aimPart)
            if Part then
                local Vec, OnScr = CurrentCamera:WorldToViewportPoint(Part.Position)
                if OnScr then
                    local Dist = (Vector2.new(Vec.X, Vec.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if Dist < minDist then
                        minDist = Dist
                        Target = P.Character
                    end
                end
            end
        end
    end
    return Target
end

local Mt = getrawmetatable(game)
local OldNC = Mt.__namecall
setreadonly(Mt, false)
Mt.__namecall = newcclosure(function(...)
    local Meth = getnamecallmethod()
    if getgenv().silentAimEnabled and Meth == "FindPartOnRay" and not checkcaller() then
        local T = getSilentTarget()
        if T and T:FindFirstChild(getgenv().aimPart) then
            local P = T[getgenv().aimPart]
            return P, P.Position
        end
    end
    return OldNC(...)
end)
setreadonly(Mt, true)

