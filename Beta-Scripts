local invisEnabled = false
local invConnections = {}
local invChar, invHum, invRoot
local invParts = {}

local function ClearInvis()
    if _G.a then
        local x,y,z = pairs(_G.a)
        while true do
            local k,v = zpcall(x,y,z)
            if k==nil then break end
            if typeof(v)=="function" or v.Disconnect then pcall(function() v:Disconnect() end) end
        end
        _G.a=nil
    end
    for _,c in pairs(invConnections) do pcall(function() c:Disconnect() end) end
    invConnections={}
end

local function ScanParts()
    invParts={}
    if not invChar then return end
    for _,d in ipairs(invChar:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency==0 then invParts[#invParts+1]=d end
    end
end

local function TogglePartVis()
    for _,p in ipairs(invParts) do
        if p and p.Parent then p.Transparency=(p.Transparency==0 and 0.5 or 0) end
    end
end

local function SetupInvisSystem()
    invChar=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    invHum=invChar:WaitForChild("Humanoid")
    invRoot=invChar:WaitForChild("HumanoidRootPart")
    ScanParts()
end

local function SetInvis(state)
    invEnabled=state
    if invEnabled then
        Notify("Invisibilidad ACTIVADA")
        SetupInvisSystem()
        invConnections[#invConnections+1]=RunService.Heartbeat:Connect(function()
            if not invEnabled or not invRoot or not invHum then return end
            local origC=invRoot.CFrame
            local origCamOff=invHum.CameraOffset
            local fakePos=origC*CFrame.new(0,-200000,0)
            invRoot.CFrame=fakePos
            invHum.CameraOffset=fakePos:ToObjectSpace(CFrame.new(origC.Position)).Position
            RunService.RenderStepped:Wait()
            invRoot.CFrame=origC
            invHum.CameraOffset=origCamOff
        end)
        invConnections[#invConnections+1]=invChar:WaitForChild("HumanoidRootPart").ChildAdded:Connect(ScanParts)
    else
        Notify("Invisibilidad DESACTIVADA")
        for _,c in pairs(invConnections) do pcall(function() c:Disconnect() end) end
        invConnections={}
        for _,p in ipairs(invParts) do if p and p.Parent then p.Transparency=0 end end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    if invEnabled then ClearInvis() SetupInvisSystem() end
end)

local function SheriffShoot()
    if FindRole("Sheriff")~=LocalPlayer then Notify("No eres Sheriff") return end
    local tgt = FindRole("Murderer") if not tgt or not tgt.Character then Notify("Sin objetivo") return end
    if not EquipTool("Gun") then return end
    local c = LocalPlayer.Character local gun = c and c:FindFirstChild("Gun")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local thrp = tgt.Character:FindFirstChild("HumanoidRootPart")
    local shootEv = gun and gun:FindFirstChild("Shoot")
    if hrp and thrp and shootEv then shootEv:FireServer(hrp.CFrame, thrp.Position) Notify("Disparo enviado") end
end

local FarmSpeed = 40
local FarmConn
local function AutoFarmToggle(state)
    if FarmConn then FarmConn:Disconnect() end
    if not state then Notify("AutoFarm desactivado") return end
    Notify("AutoFarm activado")
    FarmConn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        local hrp = c.HumanoidRootPart
        local map = Workspace:FindFirstChildWhichIsA("Model",true,function(x) return x:FindFirstChild("CoinContainer") end)
        if not map then return end
        local coins = map:FindFirstChild("CoinContainer"):GetChildren() if #coins==0 then return end
        local best,bestD = nil,math.huge
        local myPos = hrp.Position
        for _,coin in ipairs(coins) do
            if coin:IsA("BasePart") or coin:IsA("Model") then
                local p = coin:IsA("Model") and coin:GetPivot().Position or coin.Position
                local d = (myPos - p).Magnitude
                if d<bestD then bestD=d best=coin end
            end
        end
        if best then
            local dest = best:IsA("Model") and best:GetPivot() or best.Position
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(dest), math.clamp(FarmSpeed/100,0.06,0.82))
        end
    end)
end

