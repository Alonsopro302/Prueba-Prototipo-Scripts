                    pr.CFrame = r.CFrame + r.CFrame.LookVector * 2
                    task.wait(0.1)
                    if st:IsA("RemoteEvent") then st:FireServer("Slash") end
                    break
                end
            end
        end
    end)
end

local function KillClosest()
    if getPlayerRole(LocalPlayer) ~= "Murderer" then Notify("Solo para Asesino"); return end
    if not EquipItem("Knife") then return end
    local cer = FindNearestPlayer()
    if not cer or not cer.Character then Notify("Sin objetivo cercano"); return end
    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local tr = cer.Character:FindFirstChild("HumanoidRootPart")
    local k = c:FindFirstChild("Knife")
    local st = k and k:FindFirstChild("Stab")
    if not r or not tr or not st then Notify("Elementos faltantes"); return end
    tr.Anchored = true
    tr.CFrame = r.CFrame + r.CFrame.LookVector * 2
    task.wait(0.1)
    st:FireServer("Slash")
end

local function KillEveryone()
    if getPlayerRole(LocalPlayer) ~= "Murderer" then Notify("Solo para Asesino"); return end
    if not EquipItem("Knife") then return end
    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local k = c:FindFirstChild("Knife")
    local st = k and k:FindFirstChild("Stab")
    if not r or not st then Notify("Configuracion incompleta"); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            if pr then pr.Anchored = true; pr.CFrame = r.CFrame + r.CFrame.LookVector end
