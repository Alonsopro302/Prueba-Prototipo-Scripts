end

local function shootMurderer()
if findSheriff() ~= LocalPlayer then
notify("You're not sheriff/hero.")
return
end

local murderer = findMurderer() or findSheriffThatsNotMe()

if not murderer or not murderer.Character then
notify("No murderer (or sheriff) to shoot.")
return
end

if not equipTool("Gun") then
return
end

local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
local character = LocalPlayer.Character
local rightHand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))

if not murdererRoot or not rightHand then
notify("Required character parts were not found.")
return
end

local predictedPosition = getPredictedPosition(murderer, shootOffset)
local args

if instakillshoot then
args = {
CFrame.new(murdererRoot.Position + Vector3.new(0, 1, 0)),
CFrame.new(murdererRoot.Position)
}
else
args = {
CFrame.new(rightHand.Position),
CFrame.new(predictedPosition)
}
end

local gun = character:FindFirstChild("Gun")
local remote = gun and gun:FindFirstChild("Shoot")

if not remote or not remote:IsA("RemoteEvent") then
notify("Gun Shoot remote was not found.")
return
end

remote:FireServer(unpack(args))
end

local function knifeThrow(silent)
if findMurderer() ~= LocalPlayer then
if not silent then
notify("You're not murderer.")
end
return
end

if not equipTool("Knife") then
return
end

local nearestPlayer = findNearestPlayer()

if not nearestPlayer or not nearestPlayer.Character then
if not silent then
notify("Can't find a player.")
end
return
end

local nearestRoot = nearestPlayer.Character:FindFirstChild("HumanoidRootPart")
local character = LocalPlayer.Character
local rightHand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))

if not nearestRoot or not rightHand then
if not silent then
notify("Required character parts were not found.")
end
return
end

local args = {
CFrame.new(rightHand.Position),
CFrame.new(getPredictedPosition(nearestPlayer, shootOffset + 1))
}

if spawnAtPlayer then
args[1] = CFrame.new(nearestRoot.Position + nearestRoot.CFrame.LookVector * 5)
end

local knife = character:FindFirstChild("Knife")
local events = knife and knife:FindFirstChild("Events")
local remote = events and events:FindFirstChild("KnifeThrown")

if not remote or not remote:IsA("RemoteEvent") then
if not silent then
notify("KnifeThrown remote was not found.")
end
return
end

remote:FireServer(unpack(args))
end

