local function enableNoclip()
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function returnCoinContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearestCoin(container)
    if not container then return nil, 0 end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, 0 end
    local nearestCoin = nil
    local nearestDist = math.huge
    for _, coin in pairs(container:GetChildren()) do
        if coin:GetAttribute("CoinID") == "Coin" and coin:FindFirstChild("TouchInterest") and coin.Transparency == 1 then
            local dist = (root.Position - coin.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearestCoin = coin
            end
        end
    end
    return nearestCoin, nearestDist
end

local function startFarming()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    if not originalCFrame then
        originalCFrame = root.CFrame
    end
    humSpeed = hum.WalkSpeed
    originalCollision = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCollision[part] = {
                CanCollide = part.CanCollide,
                Massless = part.Massless
            }
        end
    end
    root.CFrame = root.CFrame - Vector3.new(0, 2.5, 0)
    root.CFrame = root.CFrame * CFrame.Angles(math.rad(90), 0, 0)
    if hum then
        hum.PlatformStand = true
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end
    if velocityLoop then
        velocityLoop:Disconnect()
        velocityLoop = nil
    end
    velocityLoop = RunService.Heartbeat:Connect(function()
        if isFarming and root and root.Parent then
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end
    end)
    isFarming = true
end

local function stopFarming()
    isFarming = false
    if velocityLoop then
        velocityLoop:Disconnect()
        velocityLoop = nil
    end
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    for part, data in pairs(originalCollision) do
        if part and part.Parent then
            part.CanCollide = data.CanCollide
            part.Massless = data.Massless
        end
    end
    originalCollision = {}
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            if originalCFrame then
                root.CFrame = originalCFrame
                originalCFrame = nil
            else
                root.CFrame = root.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
                root.CFrame = root.CFrame + Vector3.new(0, 2.5, 0)
            end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum.WalkSpeed = humSpeed
        end
    end
end

local function moveToCoin(coin)
    if not coin or not coin.Parent then return end
    if not LocalPlayer.Character then return end
    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = true
    end
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    local targetPos = coin.Position - Vector3.new(0, 2.5, 0)
    local targetCFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)
    local dist = (root.Position - targetPos).Magnitude
    local duration = dist / 23
    if duration < 0.05 then
        root.CFrame = targetCFrame
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        return
    end
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    currentTween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
    currentTween.Completed:Wait()
    currentTween = nil
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
end

local function coinFarmFunction()
    while coinFarmActive do
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if not root or not hum then return end
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            if LocalPlayer:GetAttribute("Alive") ~= true then
                if isFarming then stopFarming() end
                return
            end
            hum.PlatformStand = true
            local container = returnCoinContainer()
            if not container then
                if isFarming then stopFarming() end
                return
            end
            local coin, dist = findNearestCoin(container)
            if coin and coin.Transparency == 1 then
                if not isFarming then
                    startFarming()
                end
                enableNoclip()
                hum.PlatformStand = true
                moveToCoin(coin)
                if root and coin and coin.Parent then
                    local currentDist = (root.Position - coin.Position).Magnitude
                    if currentDist <= 5 then
                        firetouchinterest(root, coin, 0)
                        firetouchinterest(root, coin, 1)
                    end
                end
            else
                if isFarming then stopFarming() end
            end
        end)
        task.wait(0.05)
    end
end

