local function DisparoRetrasado()
    if EncontrarSheriff()~=LocalPlayer then Notify("No eres Sheriff"); return end
    local objetivoDisp = EncontrarAsesino() or EncontrarSheriffNoYo()
    if not objetivoDisp or not objetivoDisp.Character then Notify("Sin objetivo valido"); return end
    if not EquiparHerramienta("Gun") then return end
    local persDisp = LocalPlayer.Character
    local raizDisp = persDisp and persDisp:FindFirstChild("HumanoidRootPart")
    local raizObjDisp = objetivoDisp.Character:FindFirstChild("HumanoidRootPart")
    if not raizDisp or not raizObjDisp then Notify("Ejes centrales invalidos"); return end
    Notify("Esperando linea visual directa...")
    local conexEsp
    conexEsp=RunService.Stepped:Connect(function()
        if not objetivoDisp.Parent or not objetivoDisp.Character or not raizObjDisp.Parent then conexEsp:Disconnect(); return end
        local origenRay = raizDisp.Position
        local direcRay = Vector3.new(raizObjDisp.Position.X, origenRay.Y, raizObjDisp.Position.Z)-origenRay
        if direcRay.Magnitude<=0 then return end
        local resultadoRay = Workspace:Raycast(origenRay, direcRay.Unit*1000)
        if resultadoRay and resultadoRay.Instance==raizObjDisp then
            local armaFinal = persDisp:FindFirstChild("Gun")
            local cuchFinal = armaFinal and armaFinal:FindFirstChild("KnifeLocal")
            local hazFinal = cuchFinal and cuchFinal:FindFirstChild("CreateBeam")
            local remotoFinal = hazFinal and hazFinal:FindFirstChild("RemoteFunction")
            if remotoFinal then
                local predFinal = ObtenerPosicionPredicha(objetivoDisp, shootOffset)
                pcall(function() remotoFinal:InvokeServer(1,predFinal,"AH2") end)
            end
            conexEsp:Disconnect()
        end
    end)
end
local function AlternarMonedasAuto(valor)
    coinAutoCollect = valor
    if coinLoop then coinLoop:Disconnect(); coinLoop = nil end
    if not coinAutoCollect then
        Notify("Recoleccion de monedas: Desactivada")
        return
    end
    Notify("Recoleccion de monedas: ACTIVADA")
    coinLoop = RunService.Heartbeat:Connect(function()
        local persAct = LocalPlayer.Character
        if not persAct then return end
        local raizPers = persAct:FindFirstChild("HumanoidRootPart")
        if not raizPers or not raizPers.Parent then return end
        local mapaAct = ObtenerMapa()
        if not mapaAct then return end
        local contenedorMon = mapaAct:FindFirstChild("CoinContainer")
        if not contenedorMon or not contenedorMon:IsDescendantOf(Workspace) then return end
        local listaMonedas = contenedorMon:GetChildren()
        if #listaMonedas < 1 then return end
        local mejorMoneda, distMinima = nil, math.huge
        local posJugador = raizPers.Position
        for _, moneda in ipairs(listaMonedas) do
            if moneda:IsA("BasePart") or moneda:IsA("Model") then
                local posMon = moneda:IsA("Model") and moneda:GetPivot().Position or moneda.Position
                local distActual = (posJugador - posMon).Magnitude
                if distActual < distMinima then
                    distMinima = distActual
                    mejorMoneda = moneda
                end
            end
        end
        if mejorMoneda then
            local posDestino = mejorMoneda:IsA("Model") and mejorMoneda:GetPivot() or mejorMoneda.Position
            local pasoSuave = math.clamp(coinSpeedMultiplier/95, 0.085, 0.92)
            raizPers.CFrame = raizPers.CFrame:Lerp(CFrame.new(posDestino), pasoSuave)
        end
    end)
end
local function AlternarTiempoRonda(valor)
    if timerTask then task.cancel(timerTask); timerTask=nil end
    if timerText then timerText:Destroy(); timerText=nil end
    if not valor then return end
    timerText=Instance.new("TextLabel")
    timerText.Name="ChitukHub_TiempoRonda"
    timerText.Parent=game:GetService("CoreGui")
    timerText.BackgroundTransparency=1
    timerText.TextColor3=Color3.new(1,1,1)
    timerText.TextScaled=true
    timerText.AnchorPoint=Vector2.new(0.5,0.5)
    timerText.Position=UDim2.fromScale(0.5,0.15)
    timerText.Size=UDim2.fromOffset(200,35)
    timerText.Font=Enum.Font.Montserrat
    timerTask=task.spawn(function()
        while timerText do
            task.wait(0.5)
            local relojRonda=Workspace:FindFirstChild("RoundTimerPart")
            if relojRonda then
                local tiempoAct = relojRonda:GetAttribute("Time")
                if type(tiempoAct)=="number" then
                    if tiempoAct==-1 then timerText.Text="" else
                        local minRonda=math.floor(tiempoAct/60)
                        local segRonda=tiempoAct%60
                        timerText.Text=string.format("%dm %ds",minRonda,segRonda)
                    end
                end
            end
        end
    end)
end
