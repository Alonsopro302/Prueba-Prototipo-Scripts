    if not near or not near.Character then if not silent then Notify("No hay objetivos cerca") end; return end
    local chr = LocalPlayer.Character
    local rh = chr and chr:FindFirstChild("RightHand")
    local nroot = near.Character:FindFirstChild("HumanoidRootPart")
    local knife = chr:FindFirstChild("Knife")
    local ev = knife and knife:FindFirstChild("Events")
    local rem = ev and ev:FindFirstChild("KnifeThrown")
    if not rh or not nroot or not rem then Notify("Cuchillo incompleto"); return end
    local posP = GetPredictedPosition(near, shootOffset+1)
    local args={CFrame.new(rh.Position), CFrame.new(posP)}
