local function AddToolESP(Tool)
    if not Tool:IsA("Tool") or not Tool:FindFirstChild("Handle") then return end
    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = getgenv().espBoxColor
    Box.Thickness = 2
    Box.Filled = false
    local Tx = Drawing.new("Text")
    Tx.Visible = false
    Tx.Color = getgenv().espTextColor
    Tx.Size = 16
    Tx.Text = Tool.Name
    RunService.RenderStepped:Connect(function()
        if getgenv().toolEspEnabled and Tool:IsDescendantOf(workspace) then
            local Vec, OnScr = CurrentCamera:WorldToViewportPoint(Tool.Handle.Position)
            if OnScr then
                Box.Size = Vector2.new(50, 50)
                Box.Position = Vector2.new(Vec.X - 25, Vec.Y - 25)
                Box.Visible = true
                Tx.Position = Vector2.new(Vec.X, Vec.Y - 30)
                Tx.Visible = true
            else
                Box.Visible = false
                Tx.Visible = false
            end
        else
            Box.Visible = false
            Tx.Visible = false
        end
    end)
end

