    pcall(function()
        if getPlayerRole(LocalPlayer) ~= "Sheriff" then
            Notify("No eres Sheriff! Desactivado")
            DesactivarAutoShootMurderer()
            return
        end
        local gun = nil
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('Gun') then
            gun = LocalPlayer.Character.Gun
        elseif LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild('Gun') then
            gun = LocalPlayer.Backpack.Gun
            gun.Parent = LocalPlayer.Character
        end
        if not gun then return end
        local murderer = nil
        local getPlayerData = ReplicatedStorage:FindFirstChild('GetPlayerData', true)
        if getPlayerData then
            local success, data = pcall(function() return getPlayerData:InvokeServer() end)
            if success and data then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player:GetAttribute('Alive') == true then
                        local playerData = data[player.Name]
                        if playerData and playerData.Role and playerData.Role == 'Murderer' then
                            murderer = player
                            break
                        end
                    end
                end
            end
        end
        if not murderer then
            murderer = EncontrarAsesino()
        end
        if not murderer then return end
        local murdererChar = murderer.Character
        if not murdererChar then return end
        local murdererHRP = murdererChar:FindFirstChild('HumanoidRootPart')
        local murdererTorso = murdererChar:FindFirstChild('Torso') or murdererChar:FindFirstChild('UpperTorso')
        if not murdererHRP or not murdererTorso then return end
        if not LocalPlayer.Character then return end
        local myHRP = LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
        if not myHRP then return end
        local stats = game:GetService('Stats')
        local ping = stats.Network.ServerStatsItem['Data Ping']:GetValue()
        local pingSeconds = (ping / 1000) * 1.25
        local murdererVelocity = murdererHRP.Velocity
        local speed = murdererVelocity.Magnitude
        local targetPos
        if speed < 1 then
            targetPos = murdererTorso.Position
        else
            targetPos = murdererTorso.Position + (murdererVelocity * pingSeconds)
        end
        local shootCFrame = CFrame.new(myHRP.Position, targetPos)
        local targetCFrame = CFrame.new(targetPos)
        local shootEvent = gun:FindFirstChild('ShootEvent') or gun:FindFirstChild('Shoot')
        if shootEvent then
            shootEvent:FireServer(shootCFrame, targetCFrame)
        end
    end)
end

