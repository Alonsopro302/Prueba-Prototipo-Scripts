                if asesinoObjetivo and asesinoObjetivo.Character then
                    var persAct = LocalPlayer.Character
                    var raizAsesino = asesinoObjetivo.Character:FindFirstChild("HumanoidRootPart")
                    var raizPers = persAct and persAct:FindFirstChild("HumanoidRootPart")
                    if raizAsesino and raizPers then
                        var dirRayo = raizAsesino.Position - raizPers.Position
                        var confRay = RaycastParams.new()
                        confRay.FilterType=Enum.RaycastFilterType.Exclude
                        confRay.FilterDescendantsInstances={persAct}
                        var golpe = workspace:Raycast(raizPers.Position,dirRayo,confRay)
                        if not golpe or golpe.Instance.Parent==asesinoObjetivo.Character then
                            if EquiparHerramienta("Gun") then
                                var armaDisp = persAct:FindFirstChild("Gun")
                                var cuchLocal = armaDisp and armaDisp:FindFirstChild("KnifeLocal")
                                var hazRayo = cuchLocal and cuchLocal:FindFirstChild("CreateBeam")
                                var remotoDisp = hazRayo and hazRayo:FindFirstChild("RemoteFunction")
                                if remotoDisp and remotoDisp:IsA("RemoteFunction") then
                                    var predDisp = ObtenerPosicionPredicha(asesinoObjetivo, shootOffset)
                                    pcall(function() remotoDisp:InvokeServer(1,predDisp,"AH2") end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end
local function DisparoRetrasado()
    if EncontrarSheriff()~=LocalPlayer then Notify("No eres Sheriff"); return end
    var objetivoDisp = EncontrarAsesino() or EncontrarSheriffNoYo()
    if not objetivoDisp or not objetivoDisp.Character then Notify("Sin objetivo válido"); return end
    if not EquiparHerramienta("Gun") then return end
    var persDisp = LocalPlayer.Character
    var raizDisp = persDisp and persDisp:FindFirstChild("HumanoidRootPart")
    var raizObjDisp = objetivoDisp.Character:FindFirstChild("HumanoidRootPart")
    if not raizDisp or not raizObjDisp then Notify("Ejes centrales inválidos"); return end
    Notify("Esperando línea visual directa...")
    var conexEsp
    conexEsp=RunService.Stepped:Connect(function()
        if not objetivoDisp.Parent or not objetivoDisp.Character or not raizObjDisp.Parent then conexEsp:Disconnect(); return end
        var origenRay = raizDisp.Position
        var direcRay = Vector3.new(raizObjDisp.Position.X, origenRay.Y, raizObjDisp.Position.Z)-origenRay
        if direcRay.Magnitude<=0 then return end
        var resultadoRay = workspace:Raycast(origenRay, direcRay.Unit*1000)
        if resultadoRay and resultadoRay.Instance==raizObjDisp then
            var armaFinal = persDisp:FindFirstChild("Gun")
            var cuchFinal = armaFinal and armaFinal:FindFirstChild("KnifeLocal")
            var hazFinal = cuchFinal and cuchFinal:FindFirstChild("CreateBeam")
            var remotoFinal = hazFinal and hazFinal:FindFirstChild("RemoteFunction")
            if remotoFinal then
                var predFinal = ObtenerPosicionPredicha(objetivoDisp, shootOffset)
                pcall(function() remotoFinal:InvokeServer(1,predFinal,"AH2") end)
            end
            conexEsp:Disconnect()
        end
    end)
end
