    if not target then return end
    self:Remove(target)
    data = data or {}
    local color = data.AccentColor or Color3.new(1, 1, 0)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ChitukHub_" .. HttpService:GenerateGUID(false)
    highlight.Adornee = target
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = data.HighlightFillTransparency or 0.7
    highlight.OutlineTransparency = data.HighlightOutlineTransparency or 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = self.Gui
    local arrow, distanceLabel, arrowScale
    if data.ArrowShow then
        arrow = self.ArrowTemplate:Clone()
        arrow.Name = "Arrow_" .. HttpService:GenerateGUID(false)
        arrow.ImageColor3 = color
        arrow.Visible = true
        arrow.Parent = self.Gui
        arrowScale = Instance.new("UIScale")
        arrowScale.Scale = 1
        arrowScale.Parent = arrow
        if data.ArrowShowDistanceText ~= false then
            distanceLabel = Instance.new("TextLabel")
            distanceLabel.Name = "DistanceLabel"
            distanceLabel.Size = UDim2.fromOffset(90, 24)
            distanceLabel.Position = UDim2.new(0.5, 0, 1, 0)
            distanceLabel.AnchorPoint = Vector2.new(0.5, 0)
            distanceLabel.BackgroundTransparency = 1
            distanceLabel.TextColor3 = color
            distanceLabel.TextSize = 18
            distanceLabel.Font = Enum.Font.Montserrat
            distanceLabel.Parent = arrow
        end
    end
    local label
    if data.ShowLabel then
        label = Instance.new("BillboardGui")
        label.Name = "Label_" .. HttpService:GenerateGUID(false)
        label.Size = UDim2.fromOffset(100, 40)
        label.StudsOffset = Vector3.new(0, 2, 0)
        label.AlwaysOnTop = true
        label.MaxDistance = 99999
        label.Adornee = target
        label.Parent = self.Gui
