local function EncontrarJugadorCercano()
    local cercano, distMin = nil, math.huge
    local pers = LocalPlayer.Character
    local raiz = pers and pers:FindFirstChild("HumanoidRootPart")
    if not raiz then return nil end
    for _, jug in ipairs(Players:GetPlayers()) do
        if jug~=LocalPlayer and jug.Character then
            local raizJug = jug.Character:FindFirstChild("HumanoidRootPart")
            if raizJug then
                local dist = (raiz.Position - raizJug.Position).Magnitude
                if dist < distMin then distMin = dist; cercano = jug end
            end
        end
    end
    return cercano
end
local function ObtenerPosicionPredicha(jug, desplazamiento)
    if not jug or not jug.Character then return Vector3.zero end
    local pers = jug.Character
    local parteSupTorso = pers:FindFirstChild("UpperTorso") or pers:FindFirstChild("HumanoidRootPart")
    local hum = pers:FindFirstChild("Humanoid")
    if not parteSupTorso or not hum then return Vector3.zero end
    if predictionAIEngine and not predictionOngoing and not predictionCooldown then
        local red = getgenv().ChitukHubNetwork
        if red and type(red.predecirPosicion) == "function" then
            local miPers = LocalPlayer.Character
            local miTorso = miPers and (miPers:FindFirstChild("UpperTorso") or miPers:FindFirstChild("HumanoidRootPart"))
            if miTorso and (parteSupTorso.Position - miTorso.Position).Magnitude > 20 then
                predictionCooldown = true; predictionOngoing = true
                local ok, resultado = pcall(function() return red:predecirPosicion(jug) end)
                predictionOngoing = false
                task.delay(5, function() predictionCooldown = false end)
                if ok and typeof(resultado)=="Vector3" then return resultado end
            end
        end
    end
    local vel = parteSupTorso.AssemblyLinearVelocity
    local dirMovimiento = hum.MoveDirection
    local posPredicha = parteSupTorso.Position + vel*Vector3.new(0.75,0.5,0.75)*(desplazamiento/15) + dirMovimiento*desplazamiento
    posPredicha *= ((LocalPlayer:GetNetworkPing()*1000)*((offsetToPingMult-1)*0.01)+1)
    return posPredicha
end
local function EquiparHerramienta(nombre)
    local pers = LocalPlayer.Character
    local hum = pers and pers:FindFirstChildOfClass("Humanoid")
    if not pers or not hum then Notify("Personaje invalido"); return false end
    if pers:FindFirstChild(nombre) then return true end
    local herramienta = LocalPlayer.Backpack:FindFirstChild(nombre)
    if not herramienta then Notify("Herramienta faltante: "..nombre); return false end
    hum:EquipTool(herramienta)
    return pers:FindFirstChild(nombre)~=nil
end
local function DispararAsesino()
    if EncontrarSheriff()~=LocalPlayer then Notify("No eres Sheriff"); return end
    local objetivo = EncontrarAsesino() or EncontrarSheriffNoYo()
    if not objetivo or not objetivo.Character then Notify("Objetivo no hallado"); return end
    if not EquiparHerramienta("Gun") then return end
    local pers = LocalPlayer.Character
    local manoDerecha = pers and pers:FindFirstChild("RightHand")
    local raizObj = objetivo.Character:FindFirstChild("HumanoidRootPart")
    local arma = pers:FindFirstChild("Gun")
    local eventoDisp = arma and arma:FindFirstChild("Shoot")
    if not manoDerecha or not raizObj or not eventoDisp then Notify("Partes de arma faltantes"); return end
    local posPred = ObtenerPosicionPredicha(objetivo, shootOffset)
    local args
    if instakillshoot then
        args={CFrame.new(raizObj.Position+Vector3.new(0,1,0)), CFrame.new(raizObj.Position)}
    else
        args={CFrame.new(manoDerecha.Position), CFrame.new(posPred)}
    end
    eventoDisp:FireServer(unpack(args))
end
local function LanzarCuchillo(silencioso)
    if EncontrarAsesino()~=LocalPlayer then if not silencioso then Notify("No eres Asesino") end; return end
    if not EquiparHerramienta("Knife") then return end
    local cercano = EncontrarJugadorCercano()
    if not cercano or not cercano.Character then if not silencioso then Notify("Sin objetivo cercano") end; return end
    local pers = LocalPlayer.Character
    local manoDerecha = pers and pers:FindFirstChild("RightHand")
    local raizCercano = cercano.Character:FindFirstChild("HumanoidRootPart")
    local cuchillo = pers:FindFirstChild("Knife")
    local ev = cuchillo and cuchillo:FindFirstChild("Events")
    local eventoLanzar = ev and ev:FindFirstChild("KnifeThrown")
    if not manoDerecha or not raizCercano or not eventoLanzar then Notify("Cuchillo incompleto"); return end
    local posPred = ObtenerPosicionPredicha(cercano, shootOffset+1)
    local args={CFrame.new(manoDerecha.Position), CFrame.new(posPred)}
    if spawnAtPlayer then args[1] = CFrame.new(raizCercano.Position + raizCercano.CFrame.LookVector*5) end
    eventoLanzar:FireServer(unpack(args))
end
