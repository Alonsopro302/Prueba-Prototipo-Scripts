local function FindRole(role)
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then
            if role=="Murderer" and p.Character:FindFirstChild("Knife") then return p end
            if role=="Sheriff" and p.Character:FindFirstChild("Gun") then return p end
        end
    end return nil
end

local function EquipTool(name)
    local c = LocalPlayer.Character if not c or not c:FindFirstChildWhichIsA("Humanoid") then return false end
    if c:FindFirstChild(name) then return true end
    local it = LocalPlayer.Backpack:FindFirstChild(name) if it then c.Humanoid:EquipTool(it) return true end return false
end

