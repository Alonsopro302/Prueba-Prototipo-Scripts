function ESP.new()
local self = setmetatable({}, ESP)
self.Groups = {}
self.Indicators = {}
self.TargetIndex = {}
self.ScreenGui = Instance.new("ScreenGui")
self.ScreenGui.Name = "YARHM_MM2_ESP"
self.ScreenGui.IgnoreGuiInset = true
self.ScreenGui.ResetOnSpawn = false
self.ScreenGui.Parent = game:GetService("CoreGui")
self.ArrowTemplate = Instance.new("ImageLabel")
self.ArrowTemplate.Name = "ArrowTemplate"
self.ArrowTemplate.Size = UDim2.fromOffset(40, 40)
self.ArrowTemplate.AnchorPoint = Vector2.new(0.5, 0.5)
self.ArrowTemplate.BackgroundTransparency = 1
self.ArrowTemplate.Image = "rbxassetid://97136202386756"
self.ArrowTemplate.Visible = false
self.ArrowTemplate.Parent = self.ScreenGui
self.ArrowScaler = Instance.new("UIScale")
self.ArrowScaler.Scale = 0
self.ArrowScaler.Parent = self.ArrowTemplate
self.UpdateConnection = RunService.RenderStepped:Connect(function()
self:Update()
end)
return self
end

function ESP:AddGroup(name)
if not self.Groups[name] then
self.Groups[name] = {
enabled = true,
properties = {},
targets = {}
}
end
return self.Groups[name]
end

function ESP:Add(target, options)
if not target then
return
end
options = options or {}
self:Remove(target)

local accent = options.AccentColor or Color3.new(1, 1, 0)

local highlight = Instance.new("Highlight")
highlight.Name = "Highlight_" .. HttpService:GenerateGUID(false)
highlight.Adornee = target
highlight.FillTransparency = options.HighlightFillTransparency or 0.7
highlight.OutlineTransparency = options.HighlightOutlineTransparency or 0
highlight.FillColor = accent
highlight.OutlineColor = accent
highlight.DepthMode = options.HighlightDepthMode or Enum.HighlightDepthMode.AlwaysOnTop
highlight.Parent = self.ScreenGui

local arrow
local arrowScale
local distanceLabel

if options.ArrowShow then
arrow = self.ArrowTemplate:Clone()
arrow.Name = "Arrow_" .. HttpService:GenerateGUID(false)
arrow.ImageColor3 = accent
arrow.Visible = true
arrow.Parent = self.ScreenGui

arrowScale = arrow:FindFirstChildOfClass("UIScale")

if not arrowScale then
arrowScale = Instance.new("UIScale")
arrowScale.Parent = arrow
end

if options.ArrowShowDistanceText ~= false then
distanceLabel = Instance.new("TextLabel")
distanceLabel.Name = "DistanceLabel"
distanceLabel.AnchorPoint = Vector2.new(0.5, 0)
distanceLabel.Position = UDim2.fromScale(0.5, 1)
distanceLabel.Size = UDim2.fromOffset(90, 24)
distanceLabel.BackgroundTransparency = 1
distanceLabel.Font = Enum.Font.Montserrat
distanceLabel.TextSize = 16
distanceLabel.TextColor3 = accent
distanceLabel.TextStrokeTransparency = 0
distanceLabel.Parent = arrow
end
end

local label

if options.ShowLabel then
label = Instance.new("BillboardGui")
label.Name = "Label_" .. HttpService:GenerateGUID(false)
label.AlwaysOnTop = true
label.MaxDistance = options.LabelMaxDistance or 99999
label.Size = UDim2.fromOffset(100, 40)
label.StudsOffset = options.LabelOffset or Vector3.new(0, 2, 0)
label.Adornee = target
label.Parent = self.ScreenGui

local text = Instance.new("TextLabel")
text.Name = "TextLabel"
text.Size = UDim2.fromScale(1, 1)
text.BackgroundTransparency = 1
text.Font = Enum.Font.SourceSansBold
text.TextScaled = true
text.TextWrapped = true
text.Text = options.LabelText or "Target"
text.TextColor3 = accent
text.TextStrokeTransparency = 0
text.Parent = label
end

self.Indicators[target] = {
Highlight = highlight,
Arrow = arrow,
ArrowScale = arrowScale,
DistanceLabel = distanceLabel,
Label = label,
Options = options
}

if options.GroupName then
local group = self:AddGroup(options.GroupName)
table.insert(group.targets, target)

local targetGroups = self.TargetIndex[target] or {}
self.TargetIndex[target] = targetGroups
table.insert(targetGroups, options.GroupName)

for property, value in pairs(group.properties) do
self:SetGroupProperty(options.GroupName, property, value)
end

if not group.enabled then
highlight.Enabled = false
if arrow then
arrow.Visible = false
end
if label then
label.Enabled = false
end
end
end
end

function ESP:Remove(target)
local item = self.Indicators[target]

if not item then
return
end

if item.Highlight then
item.Highlight:Destroy()
end

if item.Arrow then
item.Arrow:Destroy()
end

if item.Label then
item.Label:Destroy()
end

local groups = self.TargetIndex[target]

if groups then
for _, groupName in ipairs(groups) do
local group = self.Groups[groupName]

if group then
for index, value in ipairs(group.targets) do
if value == target then
table.remove(group.targets, index)
break
end
end
end
end
end

self.TargetIndex[target] = nil
self.Indicators[target] = nil
end

function ESP:RemoveGroup(name)
local group = self.Groups[name]

if not group then
return
end

local targets = table.clone(group.targets)

for _, target in ipairs(targets) do
self:Remove(target)
end

self.Groups[name] = nil
end

function ESP:ClearAllGroups()
local names = {}

for name in pairs(self.Groups) do
table.insert(names, name)
end

for _, name in ipairs(names) do
self:RemoveGroup(name)
end
end

function ESP:ToggleGroup(name, enabled)
local group = self.Groups[name]

if not group then
return
end

group.enabled = enabled

for _, target in ipairs(group.targets) do
local item = self.Indicators[target]

if item then
item.Highlight.Enabled = enabled

if item.Arrow then
item.Arrow.Visible = enabled
end

if item.Label then
item.Label.Enabled = enabled
end
end
end
end

function ESP:SetGroupProperty(name, property, value)
local group = self:AddGroup(name)
group.properties[property] = value

for _, target in ipairs(group.targets) do
local item = self.Indicators[target]

if item and property == "AccentColor" then
item.Highlight.FillColor = value
item.Highlight.OutlineColor = value

if item.Arrow then
item.Arrow.ImageColor3 = value
end

if item.DistanceLabel then
item.DistanceLabel.TextColor3 = value
end

if item.Label and item.Label:FindFirstChild("TextLabel") then
item.Label.TextLabel.TextColor3 = value
end
end
end
end

function ESP:Update()
local camera = workspace.CurrentCamera

if not camera then
return
end

local viewport = camera.ViewportSize
local edgePadding = 50

for target, item in pairs(self.Indicators) do
if item.Arrow and item.ArrowScale then
local position

if target:IsA("Model") then
position = target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position
elseif target:IsA("BasePart") then
position = target.Position
end

if position then
local screenPosition, onScreen = camera:WorldToViewportPoint(position)
local distance = (camera.CFrame.Position - position).Magnitude
local minDistance = item.Options.ArrowMinDistance or 0

if onScreen and distance <= minDistance then
item.ArrowScale.Scale = 0
else
local centerX = viewport.X / 2
local centerY = viewport.Y / 2
local usableX = math.max(viewport.X - edgePadding * 2, 1)
local usableY = math.max(viewport.Y - edgePadding * 2, 1)
local clampedX = math.clamp(screenPosition.X, edgePadding, viewport.X - edgePadding)
local clampedY = math.clamp(screenPosition.Y, edgePadding, viewport.Y - edgePadding)

if onScreen and clampedX == screenPosition.X and clampedY == screenPosition.Y then
item.ArrowScale.Scale = 0
else
local relative = camera.CFrame:VectorToObjectSpace(position - camera.CFrame.Position)
local direction = Vector2.new(relative.X, relative.Y)

if direction.Magnitude > 0 then
direction = direction.Unit

local halfX = usableX / 2
local halfY = usableY / 2
local offset

if math.abs(direction.Y) > halfY / math.max(halfX, 1) then
offset = direction * math.abs(halfY / math.max(math.abs(direction.Y), 0.0001))
else
offset = direction * math.abs(halfX / math.max(math.abs(direction.X), 0.0001))
end

local x = centerX + offset.X
local y = centerY - offset.Y

item.Arrow.Position = UDim2.fromOffset(x, y)
item.Arrow.Rotation = math.deg(math.atan2(direction.X, direction.Y))
item.ArrowScale.Scale = 1

if item.DistanceLabel then
item.DistanceLabel.Text = string.format("%dm", math.round(distance))
end
end
end
end
end
end
end

function ESP:Destroy()
if self.UpdateConnection then
self.UpdateConnection:Disconnect()
end

self:ClearAllGroups()

if self.ScreenGui then
self.ScreenGui:Destroy()
end
end

