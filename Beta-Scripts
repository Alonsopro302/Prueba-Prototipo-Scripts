local function MurdererKillAllNew()
    if FindRole("Murderer")~=LocalPlayer then Notify("No eres Asesino"); return end
    if not EquipTool("Knife") then return end
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local knife = c and c:FindFirstChild("Knife")
    local stab = knife and knife:FindFirstChild("Stab")
    if not hrp or not stab then Notify("Falta arma/evento"); return end
    Notify("Ejecutando KillAll (versión nueva)")
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local thrp = p.Character.HumanoidRootPart
            thrp.Anchored = true
            thrp.CFrame = hrp.CFrame * CFrame.new(0,0,-2.5)
            task.wait(0.04)
            p.Character.Humanoid.Health = 0
            pcall(function() stab:FireServer("Slash") end)
        end
    end
end

