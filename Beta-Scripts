workspace.ChildAdded:Connect(function(ch)
    if playerESP and ch==GetMap() then
        task.spawn(function()
            Notify("Map detected, loading...")
            repeat task.wait(0.8) until not playerESP or FindSheriff() or FindMurderer()
            if playerESP then ReloadESP() end
        end)
    end
end)

workspace.DescendantAdded:Connect(function(desc)
    if trapDetection and desc.Name=="Trap" and desc:IsA("BasePart") then
        ESPContainer:Add(desc,{AccentColor=Color3.new(1,0,0),ShowLabel=true,LabelText="TRAP",GroupName="trap"})
    end
    if gunDropESP and desc.Name=="GunDrop" then
        ESPContainer:Add(desc,{AccentColor=Color3.new(0.95,1,0.07),LabelText="DROPPED GUN",ShowLabel=true,GroupName="gun"})
        if autoGetDroppedGun then
            task.spawn(function()
                task.wait(0.6)
                local c=LocalPlayer.Character
                if not (c and desc:IsDescendantOf(GetMap())) then return end
                local prev=c:GetPivot()
                c:PivotTo(desc:GetPivot())
                LocalPlayer.Backpack.ChildAdded:Wait()
                if LocalPlayer.Character then LocalPlayer.Character:PivotTo(prev) end
            end)
        end
    end
end)

workspace.DescendantRemoving:Connect(function(desc)
    if gunDropESP and desc.Name=="GunDrop" then
        ESPContainer:RemoveGroup("gun")
        if playerESP then ReloadESP() end
    end
end)

workspace.ChildAdded:Connect(function(child)
    if child.Name=="ThrowingKnife" and ignoreKnifeThrow then child:Destroy() end
end)

