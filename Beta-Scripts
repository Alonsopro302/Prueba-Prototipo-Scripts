local function ReloadESP()
    if not playerESP then return end
    ESPMgr:ClearGroup("jugadores")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer or not hideMeEsp then
            if p.Character then
                local role = getPlayerRole(p)
                if role == "Murderer" then
                    ESPMgr:Add(p.Character, {
                        Color = Color3.new(1, 0, 0.015), ShowArrow = true, MinArrowDist = 999999,
                        Label = "Asesino", ShowLabel = true, Group = "jugadores"
                    })
                elseif role == "Sheriff" then
                    ESPMgr:Add(p.Character, {
                        Color = Color3.new(0, 0.6, 1), ShowArrow = false, ShowLabel = false, Group = "jugadores"
                    })
                else
                    ESPMgr:Add(p.Character, {
                        Color = Color3.new(0, 1, 0.03), ShowArrow = false, ShowLabel = false, Group = "jugadores"
                    })
                end
            end
        end
    end
end

local function FindNearestPlayer()
    local cercano, distMin = nil, math.huge
    local pers = LocalPlayer.Character
    local raiz = pers and pers:FindFirstChild("HumanoidRootPart")
    if not raiz then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local rj = p.Character:FindFirstChild("HumanoidRootPart")
            if rj then
                local d = (raiz.Position - rj.Position).Magnitude
                if d < distMin then distMin = d; cercano = p end
            end
        end
    end
    return cercano
end

local function EquipItem(name)
    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not c or not hum then return false end
    if c:FindFirstChild(name) then return true end
    local it = LocalPlayer.Backpack:FindFirstChild(name)
    if it then hum:EquipTool(it); return true end
    return false
end

local function KnifeThrow(silencioso)
    if getPlayerRole(LocalPlayer) ~= "Murderer" then
        if not silencioso then Notify("No eres el Asesino") end
        return
    end
    if not EquipItem("Knife") then return end
    local cercano = FindNearestPlayer()
    if not cercano or not cercano.Character then
        if not silencioso then Notify("Sin objetivo cercano") end
        return
    end
    local c = LocalPlayer.Character
    local rh = c and c:FindFirstChild("RightHand")
    local nr = cercano.Character:FindFirstChild("HumanoidRootPart")
    local knife = c:FindFirstChild("Knife")
    local ev = knife and knife:FindFirstChild("Events")
    local rem = ev and ev:FindFirstChild("KnifeThrown")
    if not rh or not nr or not rem then
        Notify("Cuchillo incompleto")
        return
    end
    local args = {CFrame.new(rh.Position), CFrame.new(nr.Position)}
    if spawnAtPlayer then
        args[1] = CFrame.new(nr.Position + nr.CFrame.LookVector * 5)
    end
    rem:FireServer(unpack(args))
end

