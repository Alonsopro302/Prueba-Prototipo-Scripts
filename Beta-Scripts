WeaponsSection:CreateDropdown({
    Name = "Give Gun",
    Options = {"AK-47", "M4AI", "Riot Sheild", "Remington 870", "M9"},
    CurrentOption = "AK-47",
    Flag = "GiveGun",
    Callback = function(Option)
        local plr = game:GetService("Players").LocalPlayer
        local HumanoidRootPartCFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
        
        local function unsit()
            plr.Character:FindFirstChildOfClass("Humanoid").Sit = false
        end
        
        local function MoveTo(cFrame)
            unsit()
            pcall(function()
                if typeof(cFrame):lower() == "position" then
                    cFrame = CFrame.new(cFrame)
                end
                for i = 1, 3 do
                    plr.Character:FindFirstChild("HumanoidRootPart").CFrame = cFrame
                end
            end)
        end
        
        local function GetGun(gunName)
            local PrimaryPartCFrame = game:GetService("Players").LocalPlayer.Character:GetPrimaryPartCFrame()
            if workspace.Prison_ITEMS.giver:FindFirstChild(gunName) and workspace.Prison_ITEMS.giver:FindFirstChild(gunName):FindFirstChild("ITEMPICKUP") then
                local firstChild = workspace.Prison_ITEMS.giver:FindFirstChild(gunName)
                local Part = firstChild:FindFirstChildOfClass("Part")
                MoveTo(CFrame.new(Part.Position))
                while true do
                    wait()
                    local part = firstChild:FindFirstChildOfClass("Part")
                    MoveTo(CFrame.new(part.Position))
                    task.spawn(function()
                        workspace.Remote.ItemHandler:InvokeServer(part)
                    end)
                    wait()
                    if plr.Backpack:FindFirstChild(firstChild.Name) or plr.Character:FindFirstChild(firstChild.Name) then
                        break
                    end
                end
            end
            plr.Character:SetPrimaryPartCFrame(PrimaryPartCFrame)
        end
        
        GetGun(Option)
        wait(0.25)
        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = HumanoidRootPartCFrame
    end
})

