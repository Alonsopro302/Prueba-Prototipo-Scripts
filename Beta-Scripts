local function getPlayerRole(player)
    if not player or not player.Character then return "Inocente" end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            local name = obj.Name:lower()
            if name:find("knife") or name:find("faca") then
                return "Murderer"
            elseif name:find("gun") or name:find("arma") or name:find("revolver") then
                return "Sheriff"
            end
        end
    end
    if backpack then
        for _, obj in pairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then
                local name = obj.Name:lower()
                if name:find("knife") or name:find("faca") then
                    return "Murderer"
                elseif name:find("gun") or name:find("arma") or name:find("revolver") then
                    return "Sheriff"
                end
            end
        end
    end
    return "Inocente"
end

local ESP = {}
ESP.__index = ESP
function ESP.new()
    local self = setmetatable({}, ESP)
    self.Groups = {}
    self.Indicators = {}
    self.Gui = Instance.new("ScreenGui")
    self.Gui.Name = "ChitukESP"
    self.Gui.ResetOnSpawn = false
    self.Gui.IgnoreGuiInset = true
    self.Gui.Parent = game:GetService("CoreGui")
    self.ArrowTpl = Instance.new("ImageLabel")
    self.ArrowTpl.Size = UDim2.fromOffset(40, 40)
    self.ArrowTpl.AnchorPoint = Vector2.new(0.5, 0.5)
    self.ArrowTpl.BackgroundTransparency = 1
    self.ArrowTpl.Image = "rbxassetid://97136202386756"
    self.ArrowTpl.Visible = false
    self.ArrowTpl.Parent = self.Gui
    self.RenderConn = RunService.RenderStepped:Connect(function() self:Update() end)
    return self
end
function ESP:AddGroup(name)
    if not self.Groups[name] then self.Groups[name] = {Enabled = true, Targets = {}} end
    return self.Groups[name]
end
function ESP:Add(obj, data)
    if not obj then return end
    self:Remove(obj)
    data = data or {}
    self.Indicators[obj] = {Data = data}
    local color = data.Color or Color3.new(1, 1, 0)
    local hl = Instance.new("Highlight")
    hl.Name = "ChitukHL_" .. HttpService:GenerateGUID(false)
    hl.Adornee = obj
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = data.FillTrans or 0.7
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = self.Gui
    local arrow, scale, distLab
    if data.ShowArrow then
        arrow = self.ArrowTpl:Clone()
        arrow.Visible = true
        arrow.ImageColor3 = color
        arrow.Parent = self.Gui
        scale = Instance.new("UIScale")
        scale.Scale = 1
        scale.Parent = arrow
        if data.ShowDist ~= false then
            distLab = Instance.new("TextLabel")
            distLab.BackgroundTransparency = 1
            distLab.Font = Enum.Font.Montserrat
            distLab.TextColor3 = color
            distLab.TextSize = 18
            distLab.Size = UDim2.fromOffset(80, 24)
            distLab.Position = UDim2.new(0.5, 0, 1, 5)
            distLab.AnchorPoint = Vector2.new(0.5, 0)
            distLab.Parent = arrow
        end
    end
    local bill
    if data.ShowLabel then
        bill = Instance.new("BillboardGui")
        bill.Adornee = obj
        bill.AlwaysOnTop = true
        bill.MaxDistance = 99999
        bill.Size = UDim2.fromOffset(120, 45)
        bill.StudsOffset = Vector3.new(0, 2.2, 0)
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.TextScaled = true
        txt.Font = Enum.Font.SourceSansBold
        txt.TextColor3 = color
        txt.Text = data.Label or ""
        Instance.new("UIStroke").Parent = txt
        txt.Parent = bill
        bill.Parent = self.Gui
    end
    self.Indicators[obj].Highlight = hl
    self.Indicators[obj].Arrow = arrow
    self.Indicators[obj].Scale = scale
    self.Indicators[obj].DistLabel = distLab
    self.Indicators[obj].Billboard = bill
    if data.Group then
        local g = self:AddGroup(data.Group)
        table.insert(g.Targets, obj)
        if not g.Enabled then
            hl.Enabled = false
            if arrow then arrow.Visible = false end
        end
    end
end
function ESP:Remove(obj)
    local ref = self.Indicators[obj]
    if not ref then return end
    if ref.Highlight then ref.Highlight:Destroy() end
    if ref.Arrow then ref.Arrow:Destroy() end
    if ref.Billboard then ref.Billboard:Destroy() end
    for _, g in pairs(self.Groups) do
        for i = #g.Targets, 1, -1 do
            if g.Targets[i] == obj then table.remove(g.Targets, i) end
        end
    end
    self.Indicators[obj] = nil
end
function ESP:ClearGroup(name)
    local g = self.Groups[name]
    if not g then return end
    for _, t in pairs(g.Targets) do self:Remove(t) end
    self.Groups[name] = nil
end
function ESP:Update()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local viewSize = cam.ViewportSize
    local pad = 45
    for obj, ind in pairs(self.Indicators) do
        if ind.Arrow and ind.Scale then
            local pos
            if obj:IsA("Model") then
                pos = obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position
            elseif obj:IsA("BasePart") then
                pos = obj.Position
            end
            if pos then
                local scr, vis = cam:WorldToViewportPoint(pos)
                local dist = (cam.CFrame.Position - pos).Magnitude
                local minD = ind.Data.MinArrowDist or 0
                if vis and dist > minD then
                    ind.Scale.Scale = 0
                else
                    local center = Vector2.new(viewSize.X / 2, viewSize.Y / 2)
                    local sp = cam.CFrame:VectorToObjectSpace(pos - cam.CFrame.Position)
                    local flat = Vector2.new(sp.X, sp.Y)
                    if flat.Magnitude == 0 then continue end
                    flat = flat.Unit
                    local wLim = math.max(viewSize.X - pad * 2, 1)
                    local hLim = math.max(viewSize.Y - pad * 2, 1)
                    local off
                    if math.abs(flat.Y) > hLim / wLim then
                        off = flat * (hLim / 2 / math.max(math.abs(flat.Y), 0.001))
                    else
                        off = flat * (wLim / 2 / math.max(math.abs(flat.X), 0.001))
                    end
                    ind.Arrow.Position = UDim2.fromOffset(center.X + off.X, center.Y - off.Y)
                    ind.Arrow.Rotation = math.deg(math.atan2(flat.X, flat.Y))
                    ind.Scale.Scale = 1
                    if ind.DistLabel then ind.DistLabel.Text = math.floor(dist) .. "m" end
                end
            end
        end
    end
end
