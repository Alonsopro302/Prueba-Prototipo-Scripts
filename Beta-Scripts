    local Mouse = secondaryLocalValuePlayer:GetMouse()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= secondaryLocalValuePlayer and player.Team ~= secondaryLocalValuePlayer.Team and player.Character then
            local AimPart = player.Character:FindFirstChild(getgenv().AimPart)
            if AimPart then
                local vector, dataCondition = CurrentCamera:WorldToViewportPoint(AimPart.Position)
                if dataCondition then
                    local Magnitude = (Vector2.new(vector.X, vector.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if Magnitude < huge then
                        huge = Magnitude
                        Character = player.Character
                    end
                end
            end
        end
    end
    return Character
end

