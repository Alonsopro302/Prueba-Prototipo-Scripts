local function GetItem(Nombre, Tipo)
    local Original = LocalPlayer.Character.HumanoidRootPart.CFrame
    local function Unsit() local H = LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if H then H.Sit = false end end
    local Origen = Tipo == "gun" and workspace.Prison_ITEMS.giver or workspace.Prison_ITEMS.single
    local Obj = Origen:FindFirstChild(Nombre)
    if Obj and Obj:FindFirstChild("ITEMPICKUP") then
        local Parte = Obj:FindFirstChildWhichIsA("BasePart")
        while not Parte do task.wait() Parte = Obj:FindFirstChildWhichIsA("BasePart") end
        repeat
            Unsit()
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(Parte.Position)
            task.spawn(function() workspace.Remote.ItemHandler:InvokeServer(Parte) end)
            task.wait()
        until LocalPlayer.Backpack:FindFirstChild(Nombre) or LocalPlayer.Character:FindFirstChild(Nombre)
    end
    LocalPlayer.Character.HumanoidRootPart.CFrame = Original
end
