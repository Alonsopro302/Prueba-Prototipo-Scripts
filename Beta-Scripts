local function toggleAutoShoot(value)
autoShooting = value

if not value and autoShootConnection then
autoShootConnection:Disconnect()
autoShootConnection = nil
end

if not value then
return
end

autoShootConnection = RunService.Heartbeat:Connect(function()
if not autoShooting or findSheriff() ~= LocalPlayer then
return
end

local murderer = findMurderer()
local character = LocalPlayer.Character
local murdererCharacter = murderer and murderer.Character
local localRoot = character and character:FindFirstChild("HumanoidRootPart")
local murdererRoot = murdererCharacter and murdererCharacter:FindFirstChild("HumanoidRootPart")

if not localRoot or not murdererRoot then
return
end

local direction = murdererRoot.Position - localRoot.Position
local params = RaycastParams.new()

params.FilterType = Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances = {character}

local hit = workspace:Raycast(localRoot.Position, direction, params)

if not hit or hit.Instance:IsDescendantOf(murdererCharacter) then
shootMurderer()
end
end)
end

local function delayedShoot()
if findSheriff() ~= LocalPlayer then
notify("You're not sheriff/hero.")
return
end

local murderer = findMurderer() or findSheriffThatsNotMe()

if not murderer or not murderer.Character then
notify("No murderer (or sheriff) to shoot.")
return
end

if not equipTool("Gun") then
return
end

local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
local character = LocalPlayer.Character
local localRoot = character and character:FindFirstChild("HumanoidRootPart")
local gun = character and character:FindFirstChild("Gun")
local remote = gun and gun:FindFirstChild("KnifeLocal") and gun.KnifeLocal:FindFirstChild("CreateBeam") and gun.KnifeLocal.CreateBeam:FindFirstChild("RemoteFunction")

if not murdererRoot or not localRoot or not remote or not remote:IsA("RemoteFunction") then
notify("Required shooting objects were not found.")
return
end

if delayedShootConnection then
delayedShootConnection:Disconnect()
end

notify("Waiting for murderer to be in view...")

delayedShootConnection = RunService.Stepped:Connect(function()
if not murderer.Character or not murdererRoot.Parent then
delayedShootConnection:Disconnect()
delayedShootConnection = nil
return
end

local origin = localRoot.Position
local flatDirection = Vector3.new(murdererRoot.Position.X, origin.Y, murdererRoot.Position.Z) - origin

if flatDirection.Magnitude <= 0 then
return
end

local params = RaycastParams.new()
local result = workspace:Raycast(origin, flatDirection.Unit * 1000, params)

if result and result.Instance == murdererRoot then
local predicted = getPredictedPosition(murderer, shootOffset)

pcall(function()
remote:InvokeServer(1, predicted, "AH2")
end)

delayedShootConnection:Disconnect()
delayedShootConnection = nil
end
end)
end

