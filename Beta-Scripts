                    if getRandomText == "random" or getRandomText == "all" or getRandomText == "others" then
                        return
                    end
                    for _, item in next, secondaryPlayers:GetPlayers() do
                        if item ~= searchQuery then
                            if item.Name:lower():match("^" .. getRandomText) then
                                return item
                            end
                            if item.DisplayName:lower():match("^" .. getRandomText) then
                                return item
                            end
                        end
                    end
                    return
                end
                local players = secondaryPlayers:GetPlayers()
                if table.find(players, searchQuery) then
                    table.remove(players, table.find(players, searchQuery))
                end
                return players[math.random(#players)]
            end
            getRandomFlag = true
        end
        
        local function sendNotification(title, text, duration)
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = title,
                Text = text,
                Duration = duration
            })
        end
        
        local function createEpixVel(player)
            local Character = searchQuery.Character
            local cameraSubject = Character and Character:FindFirstChildOfClass("Humanoid")
            local parent = cameraSubject and cameraSubject.RootPart
            local headContainer = player.Character
            local Humanoid = nil
            local RootPart = nil
            local Head = nil
            
            if headContainer:FindFirstChildOfClass("Humanoid") then
                Humanoid = headContainer:FindFirstChildOfClass("Humanoid")
            end
            if Humanoid and Humanoid.RootPart then
                RootPart = Humanoid.RootPart
            end
            if headContainer:FindFirstChild("Head") then
                Head = headContainer.Head
            end
            
            if not Character or not cameraSubject or not parent then
                return sendNotification("Error Occurred", "Random error", 5)
            end
            
            if parent.Velocity.Magnitude < 50 then
                getgenv().OldPos = parent.CFrame
            end
            
            if not Humanoid or not Humanoid.Sit or getRandomFlag then
                if headContainer:FindFirstChildWhichIsA("BasePart") then
                    local function updateEpixVel(input, createEpixVelNumber, updateEpixVelNumber)
                        parent.CFrame = CFrame.new(input.Position) * createEpixVelNumber * updateEpixVelNumber
                        Character:SetPrimaryPartCFrame(CFrame.new(input.Position) * createEpixVelNumber * updateEpixVelNumber)
                        parent.Velocity = Vector3.new(90000000, 900000000, 90000000)
                        parent.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
                    end
                    
                    local function handleEpixVel(input)
                        local timestamp = tick()
                        local createEpixVelNumber = 0
                        while parent and Humanoid do
                            if not (input.Velocity.Magnitude < 50) then
                                updateEpixVel(input, CFrame.new(0, 1.5, Humanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, -Humanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, 1.5, Humanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, 1.5, RootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, -RootPart.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, 1.5, RootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(-90), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                                task.wait()
                            else
                                createEpixVelNumber = createEpixVelNumber + 100
                                updateEpixVel(input, CFrame.new(0, 1.5, 0) + Humanoid.MoveDirection * input.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0) + Humanoid.MoveDirection * input.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(2.25, 1.5, -2.25) + Humanoid.MoveDirection * input.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(-2.25, -1.5, 2.25) + Humanoid.MoveDirection * input.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, 1.5, 0) + Humanoid.MoveDirection, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                                updateEpixVel(input, CFrame.new(0, -1.5, 0) + Humanoid.MoveDirection, CFrame.Angles(math.rad(createEpixVelNumber), 0, 0))
                                task.wait()
                            end
                            
                            if input.Velocity.Magnitude > 500 or input.Parent ~= player.Character or player.Parent ~= secondaryPlayers then
                                return
                            end
                            
                            local character = player.Character
                            if headContainer == not character or Humanoid.Sit or cameraSubject.Health <= 0 or tick() > timestamp + 2 then
                                return
                            end
                        end
                    end
                    
                    workspace.FallenPartsDestroyHeight = 0 / 0
                    local BodyVelocity = Instance.new("BodyVelocity")
                    BodyVelocity.Name = "EpixVel"
                    BodyVelocity.Parent = parent
                    BodyVelocity.Velocity = Vector3.new(900000000, 900000000, 900000000)
                    BodyVelocity.MaxForce = Vector3.new(1 / 0, 1 / 0, 1 / 0)
                    cameraSubject:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    
                    if RootPart then
                        handleEpixVel(RootPart)
                    elseif Head then
                        handleEpixVel(Head)
                    end
                    
                    BodyVelocity:Destroy()
                    cameraSubject:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                    workspace.CurrentCamera.CameraSubject = cameraSubject
                    
                    repeat
                        parent.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
                        Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
                        cameraSubject:ChangeState("GettingUp")
                        table.foreach(Character:GetChildren(), function(_, secondaryArgument)
                            if secondaryArgument:IsA("BasePart") then
                                secondaryArgument.RotVelocity = Vector3.new()
                                secondaryArgument.Velocity = Vector3.new()
                            end
                        end)
                        task.wait()
                    until (parent.Position - getgenv().OldPos.p).Magnitude < 25
                    
                    workspace.FallenPartsDestroyHeight = getgenv().FPDH
                    return
                end
                return
            end
            return sendNotification("Error Occurred", "Targeting is sitting", 5)
        end
        
        if not getgenv().Welcome then
            sendNotification("Pichigdasos Hub", "Enjoy!", 5)
        end
        getgenv().Welcome = true
        
        if not data[1] then
            return
        end
        
        for _, item in next, data do
            getRandom(item)
        end
        
        if getRandomFlag then
            for _, item in next, secondaryPlayers:GetPlayers() do
                createEpixVel(item)
            end
        end
        
        for _, item in next, data do
            if not getRandom(item) or getRandom(item) == searchQuery then
                if not getRandom(item) and not getRandomFlag then
                    sendNotification("Error Occurred", "Username Invalid", 5)
                end
            elseif getRandom(item).UserId == 1414978355 then
                sendNotification("Error Occurred", "This user is whitelisted! (Owner)", 5)
            else
                local player = getRandom(item)
                if player then
                    createEpixVel(player)
                end
            end
        end
    end
})

