local function LanzarFling(objetivo)
    if not objetivo or not objetivo.Character then Notify("Jugador invalido"); return end
    local pers = LocalPlayer.Character
    local hum = pers and pers:FindFirstChildOfClass("Humanoid")
    local raizHum = hum and hum.RootPart
    pers = objetivo.Character
    local humObj = pers:FindFirstChildOfClass("Humanoid")
    local raizObj = humObj and humObj.RootPart
    local cabezaObj = pers:FindFirstChild("Head")
    if not pers or not hum or not raizHum or not humObj or not raizObj then Notify("Faltan piezas para fling"); return end
    local posOriginal = raizHum.CFrame
    local altDestruccion = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = math.huge
    local cuerpoVel = Instance.new("BodyVelocity")
    cuerpoVel.Name = "ChitukHub_Fling"
    cuerpoVel.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    cuerpoVel.Velocity=Vector3.new(9e8,9e8,9e8)
    cuerpoVel.Parent=raizHum
    local piezaObjetivo = cabezaObj or raizObj
    local inicio = tick()
    while tick()-inicio<2 and piezaObjetivo.Parent and raizHum.Parent and humObj.Health>0 do
        if piezaObjetivo.Velocity.Magnitude<50 then
            local velMov = humObj.MoveDirection * humObj.WalkSpeed/1.25
            local desplazamientos={CFrame.new(0,1.5,0),CFrame.new(0,-1.5,0),CFrame.new(2.25,1.5,-2.25),CFrame.new(-2.25,-1.5,2.25)}
            for _,desp in ipairs(desplazamientos) do
                if not piezaObjetivo.Parent then break end
                raizHum.CFrame=CFrame.new(piezaObjetivo.Position)*desp+velMov
                raizHum.AssemblyLinearVelocity=Vector3.new(9e7,9e8,9e7)
                raizHum.AssemblyAngularVelocity=Vector3.new(9e8,9e8,9e8)
                task.wait()
            end
        else
            raizHum.CFrame=CFrame.new(piezaObjetivo.Position+Vector3.new(0,1.5,0))
            raizHum.AssemblyLinearVelocity=Vector3.new(9e7,9e8,9e7)
            raizHum.AssemblyAngularVelocity=Vector3.new(9e8,9e8,9e8)
            task.wait()
        end
    end
    cuerpoVel:Destroy()
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated,true)
    Workspace.CurrentCamera.CameraSubject=hum
    for _=1,30 do
        if not raizHum.Parent then break end
        raizHum.CFrame=posOriginal*CFrame.new(0,0.5,0)
        raizHum.AssemblyLinearVelocity=Vector3.zero
        raizHum.AssemblyAngularVelocity=Vector3.zero
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait()
        if (raizHum.Position-posOriginal.Position).Magnitude<25 then break end
    end
    Workspace.FallenPartsDestroyHeight=altDestruccion
end

