    chr:PivotTo(CFrame.new(sp.Position))
end

local function TeleportToMap()
    local map = GetMap()
    local chr = LocalPlayer.Character
    if not map or not chr then Notify("Map unavailable"); return end
    local spf = map:FindFirstChild("Spawns")
    if not spf or #spf:GetChildren()<1 then Notify("No spawns found"); return end
    local list = spf:GetChildren()
    local sel = list[math.random(1,#list)]
    if sel:IsA("BasePart") then chr:PivotTo(CFrame.new(sel.Position)) else chr:PivotTo(sel:GetPivot()) end
