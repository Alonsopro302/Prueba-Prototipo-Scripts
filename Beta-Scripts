-- Funciones auxiliares
local function updateCFrame()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("HumanoidRootPart") then
        Char.HumanoidRootPart.CFrame = updateCFrameResult
    end
end

local function updateInstanceProperties()
    if getgenv().antitaseEnabled then
        local Char = LocalPlayer.Character
        if Char and Char:FindFirstChild("Humanoid") then
            local Humanoid = Char.Humanoid
            if Humanoid.WalkSpeed == 0 then
                Humanoid.WalkSpeed = 16
                Humanoid.PlatformStand = false
            end
        end
    end
end

function stopSound()
    while getgenv().stopsounds do
        for _, item in ipairs(game:GetDescendants()) do
            if item:IsA("Sound") then item:Stop() end
        end
        task.wait()
    end
end

function spamSound()
    while getgenv().spamSoond do
        for _, item in ipairs(game:GetDescendants()) do
            if item:IsA("Sound") then item:Play() end
        end
        task.wait()
    end
end

function killAura()
    while getgenv().ka do
        for _, item in ipairs(Players:GetPlayers()) do
            if item ~= LocalPlayer and item.Character and item.Character:FindFirstChild("Humanoid") then
                local Dist = (item.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if Dist <= 17 then
                    for _ = 1, 25 do
                        game.ReplicatedStorage.meleeEvent:FireServer(item)
                    end
                end
            end
        end
        task.wait()
    end
end

local function handleData()
    local huge = math.huge
    local TargetChar = nil
    local Mouse = LocalPlayer:GetMouse()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team ~= LocalPlayer.Team and player.Character then
            local AimPart = player.Character:FindFirstChild(getgenv().AimPart)
            if AimPart then
                local vector, OnScreen = CurrentCamera:WorldToViewportPoint(AimPart.Position)
                if OnScreen then
                    local Magnitude = (Vector2.new(vector.X, vector.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if Magnitude < huge then
                        huge = Magnitude
                        TargetChar = player.Character
                    end
                end
            end
        end
    end
    return TargetChar
end

-- Silent Aim
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if getgenv().SilentAimEnabled and method == "FindPartOnRay" and not checkcaller() then
        local Target = handleData()
        if Target and Target:FindFirstChild(getgenv().AimPart) then
            local Part = Target[getgenv().AimPart]
            return Part, Part.Position
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

