local ESP = {}
ESP.__index = ESP
function ESP.new()
    local self = setmetatable({},{__index=ESP})
    self.Groups = {} self.Objects = {}
    self.UI = Instance.new("ScreenGui")
    self.UI.Name = "ChitukESP_Clean"
    self.UI.ResetOnSpawn = false
    self.UI.IgnoreGuiInset = true
    self.UI.Parent = game:GetService("CoreGui")
    self.ArrowBase = Instance.new("ImageLabel")
    self.ArrowBase.Size = UDim2.fromOffset(42,42)
    self.ArrowBase.AnchorPoint = Vector2.new(0.5,0.5)
    self.ArrowBase.BackgroundTransparency = 1
    self.ArrowBase.Image = "rbxassetid://97136202386756"
    self.ArrowBase.Visible = false
    self.ArrowBase.Parent = self.UI
    self.UpdateConn = RunService.RenderStepped:Connect(function() self:Refresh() end)
    return self
end
function ESP:Add(obj,opts)
    if not obj then return end
    self:Remove(obj)
    opts = opts or {}
    local color = opts.Color or Color3.new(1,0,0)
    local hl = Instance.new("Highlight")
    hl.Adornee = obj hl.FillColor = color hl.OutlineColor = color
    hl.FillTransparency = opts.FillTrans or 0.68 hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop hl.Parent = self.UI
    local arrow,scale,distLab
    if opts.Arrow then
        arrow = self.ArrowBase:Clone()
        arrow.ImageColor3 = color arrow.Visible = true arrow.Parent = self.UI
        scale = Instance.new("UIScale") scale.Parent = arrow
        if opts.ShowDist~=false then
            distLab = Instance.new("TextLabel")
            distLab.BackgroundTransparency = 1 distLab.Font = Enum.Font.Montserrat
            distLab.TextColor3 = color distLab.TextSize = 17
            distLab.Size = UDim2.fromOffset(85,24)
            distLab.Position = UDim2.new(0.5,0,1,4) distLab.AnchorPoint = Vector2.new(0.5,0)
            distLab.Parent = arrow
        end
    end
    local bill
    if opts.Label then
        bill = Instance.new("BillboardGui")
        bill.Adornee = obj bill.AlwaysOnTop = true bill.MaxDistance = 800
        bill.Size = UDim2.fromOffset(110,42) bill.StudsOffset = Vector3.new(0,2.1,0)
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1,1) txt.BackgroundTransparency = 1
        txt.TextScaled = true txt.Font = Enum.Font.GothamBold txt.Text = opts.Text or ""
        txt.TextColor3 = color txt.Parent = bill bill.Parent = self.UI
    end
    self.Objects[obj] = {Highlight=hl,Arrow=arrow,Scale=scale,Dist=distLab,Bill=bill,Data=opts}
end
function ESP:Remove(obj)
    local ref = self.Objects[obj] if not ref then return end
    if ref.Highlight then ref.Highlight:Destroy() end
    if ref.Arrow then ref.Arrow:Destroy() end
    if ref.Bill then ref.Bill:Destroy() end
    self.Objects[obj] = nil
end
function ESP:Refresh()
    local cam = Workspace.CurrentCamera if not cam then return end
    local size = cam.ViewportSize local pad = 48
    for obj,info in pairs(self.Objects) do
        if not obj:IsDescendantOf(Workspace) then self:Remove(obj) continue end
        local pos = obj:IsA("Model") and obj.PrimaryPart and obj.PrimaryPart.Position or obj:IsA("BasePart") and obj.Position
        if not pos then continue end
        local scrPt,vis = cam:WorldToViewportPoint(pos)
        local dist = (cam.CFrame.Position - pos).Magnitude
        if info.Arrow and info.Scale then
            if vis then info.Scale.Scale = 0 else
                local center = Vector2.new(size.X/2, size.Y/2)
                local spc = cam.CFrame:VectorToObjectSpace(pos - cam.CFrame.Position)
                local flat = Vector2.new(spc.X, spc.Y) if flat.Magnitude==0 then continue end
                flat = flat.Unit
                local wLim = math.max(size.X-pad*2,1)
                local hLim = math.max(size.Y-pad*2,1)
                local off
                if math.abs(flat.Y) > hLim/wLim then off=flat*(hLim/2/math.max(math.abs(flat.Y),0.001))
                else off=flat*(wLim/2/math.max(math.abs(flat.X),0.001)) end
                info.Arrow.Position=UDim2.fromOffset(center.X+off.X,center.Y-off.Y)
                info.Arrow.Rotation=math.deg(math.atan2(flat.X,flat.Y))
                info.Scale.Scale=1
                if info.Dist then info.Dist.Text = math.floor(dist).."m" end
            end
        end
    end
end
