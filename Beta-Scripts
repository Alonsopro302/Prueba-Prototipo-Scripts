local function GrabGunOnDeath()
    pcall(function()
        if getPlayerRole(LocalPlayer) == "Sheriff" then
            Notify("Eres el Sheriff!")
            return
        end
        local sheriff = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local role = getPlayerRole(p)
                if role == "Sheriff" then
                    sheriff = p
                    break
                end
            end
        end
        if not sheriff then
            Notify("No se encontro Sheriff")
            return
        end
        Notify("Monitoreando Sheriff...")
        if grabGunOnDeathConnection then
            grabGunOnDeathConnection:Disconnect()
            grabGunOnDeathConnection = nil
        end
        grabGunOnDeathConnection = RunService.Heartbeat:Connect(function()
            if not sheriff or not sheriff.Character or not sheriff.Character:FindFirstChild("Humanoid") then
                grabGunOnDeathConnection:Disconnect()
                grabGunOnDeathConnection = nil
                Notify("Sheriff murio! Ejecutando Touch Interests...")
                touchInterests()
                return
            end
            local hum = sheriff.Character:FindFirstChild("Humanoid")
            if hum and hum.Health <= 0 then
