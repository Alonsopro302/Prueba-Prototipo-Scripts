local function MiniFling(tgt)
    if not tgt or not tgt.Character then Notify("Jugador invalido"); return end
    local chr = LocalPlayer.Character
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    local tchr = tgt.Character
    local thum = tchr:FindFirstChildOfClass("Humanoid")
    local troot = thum and thum.RootPart
    local thead = tchr:FindFirstChild("Head")
    if not chr or not hum or not root or not thum or not troot then Notify("Partes faltantes para empujar"); return end
    local posAnt = root.CFrame
    local altAnt = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = math.huge
    local bv = Instance.new("BodyVelocity")
    bv.Name = "ChitukHub_Fling"
    bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    bv.Velocity=Vector3.new(9e8,9e8,9e8)
    bv.Parent=root
    local parte = thead or troot
    local ini = tick()
    while tick()-ini<2 and parte.Parent and root.Parent and thum.Health>0 do
        if parte.Velocity.Magnitude<50 then
            local vel = thum.MoveDirection * thum.WalkSpeed/1.25
            local offsets={CFrame.new(0,1.5,0),CFrame.new(0,-1.5,0),CFrame.new(2.25,1.5,-2.25),CFrame.new(-2.25,-1.5,2.25)}
            for _,of in ipairs(offsets) do
                if not parte.Parent then break end
                root.CFrame=CFrame.new(parte.Position)*of+vel
                root.AssemblyLinearVelocity=Vector3.new(9e7,9e8,9e7)
                root.AssemblyAngularVelocity=Vector3.new(9e8,9e8,9e8)
                task.wait()
            end
        else
            root.CFrame=CFrame.new(parte.Position+Vector3.new(0,1.5,0))
            root.AssemblyLinearVelocity=Vector3.new(9e7,9e8,9e7)
            root.AssemblyAngularVelocity=Vector3.new(9e8,9e8,9e8)
            task.wait()
        end
    end
    bv:Destroy()
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated,true)
    workspace.CurrentCamera.CameraSubject=hum
    for _=1,30 do
        if not root.Parent then break end
        root.CFrame=posAnt*CFrame.new(0,0.5,0)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait()
        if (root.Position-posAnt.Position).Magnitude<25 then break end
    end
    workspace.FallenPartsDestroyHeight=altAnt
end
local function ToggleAntiFling(val)
    antiFlingEnabled=val
    if antiFlingConnection then antiFlingConnection:Disconnect(); antiFlingConnection=nil end
    if val then
        antiFlingConnection=RunService.Heartbeat:Connect(function()
            local c=LocalPlayer.Character
            if not c then return end
            local rp=c:FindFirstChild("HumanoidRootPart")
            if rp then
                rp.AssemblyLinearVelocity=Vector3.zero
                rp.AssemblyAngularVelocity=Vector3.zero
                for _,con in ipairs(rp:GetChildren()) do
                    if con:IsA("BodyVelocity") or con:IsA("BodyPosition") or con:IsA("BodyGyro") or con:IsA("BodyAngularVelocity") then con:Destroy() end
                end
            end
        end)
        Notify("Anti Empuje Activado")
    else
        Notify("Anti Empuje Desactivado")
    end
end
