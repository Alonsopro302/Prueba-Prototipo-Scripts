local function ModifyGunStats(Nombre, Modificaciones)
    local Gun = LocalPlayer.Backpack:FindFirstChild(Nombre) or LocalPlayer.Character:FindFirstChild(Nombre)
    if Gun and Gun:FindFirstChild("GunStates") then
        local GS = require(Gun.GunStates)
        for k, v in pairs(Modificaciones) do GS[k] = v end
    end
end
