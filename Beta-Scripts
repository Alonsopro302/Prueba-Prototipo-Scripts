local function ToggleKillAura(value)
    if killAuraConnection then
        killAuraConnection:Disconnect()
        killAuraConnection = nil
    end

    if not value then
        return
    end

    killAuraConnection = RunService.Heartbeat:Connect(function()
        if FindMurderer() ~= LocalPlayer then
            return
        end

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local knife = character and character:FindFirstChild("Knife")
        local stab = knife and knife:FindFirstChild("Stab")

        if not root or not stab then
            return
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")

                if targetRoot and (targetRoot.Position - root.Position).Magnitude < 7 then
                    targetRoot.Anchored = true
                    targetRoot.CFrame = root.CFrame + root.CFrame.LookVector * 2

                    task.wait(0.1)

                    if stab:IsA("RemoteEvent") then
                        stab:FireServer("Slash")
                    end

                    break
                end
            end
        end
    end)
end

