local function ToggleAutoShoot(value)
    autoShooting = value

    if autoShootTask then
        task.cancel(autoShootTask)
        autoShootTask = nil
    end

    if not value then
        return
    end

    autoShootTask = task.spawn(function()
        while autoShooting do
            task.wait(0.1)

            if FindSheriff() == LocalPlayer then
                local murderer = FindMurderer()

                if murderer and murderer.Character then
                    local character = LocalPlayer.Character
                    local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
                    local characterRoot = character and character:FindFirstChild("HumanoidRootPart")

                    if murdererRoot and characterRoot then
                        local direction = murdererRoot.Position - characterRoot.Position

                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = {character}

                        local hit = workspace:Raycast(characterRoot.Position, direction, params)

                        if not hit or hit.Instance.Parent == murderer.Character then
                            if EquipTool("Gun") then
                                local gun = character:FindFirstChild("Gun")
                                local knifeLocal = gun and gun:FindFirstChild("KnifeLocal")
                                local createBeam = knifeLocal and knifeLocal:FindFirstChild("CreateBeam")
                                local remote = createBeam and createBeam:FindFirstChild("RemoteFunction")

                                if remote and remote:IsA("RemoteFunction") then
                                    local predictedPosition = GetPredictedPosition(murderer, shootOffset)

                                    pcall(function()
                                        remote:InvokeServer(1, predictedPosition, "AH2")
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function DelayedShoot()
    if FindSheriff() ~= LocalPlayer then
        Notify("You're not sheriff/hero.")
        return
    end

    local murderer = FindMurderer() or FindSheriffNotMe()

    if not murderer or not murderer.Character then
        Notify("No murderer or sheriff to shoot.")
        return
    end

    if not EquipTool("Gun") then
        return
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")

    if not root or not murdererRoot then
        Notify("Required HumanoidRootPart was not found.")
        return
    end

    Notify("Waiting for murderer to be in view.")

    local connection

    connection = RunService.Stepped:Connect(function()
        if not murderer.Parent or not murderer.Character or not murdererRoot.Parent then
            connection:Disconnect()
            return
        end

        local origin = root.Position
        local direction = Vector3.new(
            murdererRoot.Position.X,
            origin.Y,
            murdererRoot.Position.Z
        ) - origin

        if direction.Magnitude <= 0 then
            return
        end

        local result = workspace:Raycast(origin, direction.Unit * 1000)

        if result and result.Instance == murdererRoot then
            local gun = character:FindFirstChild("Gun")
            local knifeLocal = gun and gun:FindFirstChild("KnifeLocal")
            local createBeam = knifeLocal and knifeLocal:FindFirstChild("CreateBeam")
            local remote = createBeam and createBeam:FindFirstChild("RemoteFunction")

            if remote and remote:IsA("RemoteFunction") then
                local predictedPosition = GetPredictedPosition(murderer, shootOffset)

                pcall(function()
                    remote:InvokeServer(1, predictedPosition, "AH2")
                end)
            end

            connection:Disconnect()
        end
    end)
end

local function ToggleCoinAutoCollect(value)
    coinAutoCollect = value

    if not value then
        return
    end

    if coinTask then
        task.cancel(coinTask)
    end

    coinTask = task.spawn(function()
        while coinAutoCollect do
            task.wait(0.1)

            local map = GetMap()

            if map then
                local container = map:FindFirstChild("CoinContainer")

                if container and #container:GetChildren() > 1 then
                    local closestCoin = GetClosestModelToPlayer(
                        LocalPlayer,
                        container:GetChildren()
                    )

                    if closestCoin then
                        local character = LocalPlayer.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")

                        if root then
                            local targetPosition = closestCoin:GetPivot()
                            local distance = (root.Position - targetPosition.Position).Magnitude

                            local tween = TweenService:Create(
                                root,
                                TweenInfo.new(
                                    distance * 0.05,
                                    Enum.EasingStyle.Linear
                                ),
                                {
                                    CFrame = targetPosition
                                }
                            )

                            tween:Play()
                            tween.Completed:Wait()

                            task.wait(0.1)

                            if closestCoin.Parent then
                                closestCoin:Destroy()
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function ToggleRoundTimer(value)
    if timerTask then
        task.cancel(timerTask)
        timerTask = nil
    end

    if timerText then
        timerText:Destroy()
        timerText = nil
    end

    if not value then
        return
    end

    timerText = Instance.new("TextLabel")
    timerText.Name = "DarkHub_MM2_RoundTimer"
    timerText.Parent = game:GetService("CoreGui")
    timerText.BackgroundTransparency = 1
    timerText.TextColor3 = Color3.fromRGB(255, 255, 255)
    timerText.TextScaled = true
    timerText.AnchorPoint = Vector2.new(0.5, 0.5)
    timerText.Position = UDim2.fromScale(0.5, 0.15)
    timerText.Size = UDim2.fromOffset(200, 35)
    timerText.Font = Enum.Font.Montserrat

    timerTask = task.spawn(function()
        while timerText do
            task.wait(0.5)

            local timerPart = workspace:FindFirstChild("RoundTimerPart")

            if timerPart then
                local timeLeft = timerPart:GetAttribute("Time")

                if typeof(timeLeft) == "number" then
                    if timeLeft == -1 then
                        timerText.Text = ""
                    else
                        local minutes = math.floor(timeLeft / 60)
                        local seconds = timeLeft % 60
                        timerText.Text = string.format("%dm %ds", minutes, seconds)
                    end
                end
            end
        end
    end)
end

