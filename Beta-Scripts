local function ToggleNoclip(estado)
    NoclipEnabled = estado
    if NoclipLoop then NoclipLoop:Disconnect(); NoclipLoop = nil end
    if estado then
        Notify("Noclip: ACTIVADO")
        NoclipLoop = RunService.Stepped:Connect(function()
            local personaje = LocalPlayer.Character
            if not personaje then return end
            local raiz = personaje:FindFirstChild("HumanoidRootPart")
            local hum = personaje:FindFirstChild("Humanoid")
            if raiz and hum then
                raiz.CanCollide = false
                hum.AutoRotate = true
            end
        end)
    else
        Notify("Noclip: DESACTIVADO")
        task.spawn(function()
            local personaje = LocalPlayer.Character
            if not personaje then return end
            local raiz = personaje:FindFirstChild("HumanoidRootPart")
            if raiz then raiz.CanCollide = true end
        end)
    end
end

