function ESP:AgregarGrupo(nombre)
    if not self.Groups[nombre] then
        self.Groups[nombre] = {habilitado = true, objetivos = {}}
    end
    return self.Groups[nombre]
end
function ESP:Agregar(objetivo, datos)
    if not objetivo then return end
    self:Eliminar(objetivo)
    datos = datos or {}
    self.Indicators[objetivo] = {Datos = datos}
    local color = datos.ColorResaltado or Color3.new(1, 1, 0)
    local resaltado = Instance.new("Highlight")
    resaltado.Name = "Chituk_" .. HttpService:GenerateGUID(false)
    resaltado.Adornee = objetivo
    resaltado.FillColor = color
    resaltado.OutlineColor = color
    resaltado.FillTransparency = datos.TransparenciaRelleno or 0.7
    resaltado.OutlineTransparency = datos.TransparenciaContorno or 0
    resaltado.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    resaltado.Parent = self.Gui
    local flecha, etiquetaDistancia, escalaFlecha
    if datos.MostrarFlecha then
        flecha = self.ArrowTemplate:Clone()
        flecha.Name = "Flecha_" .. HttpService:GenerateGUID(false)
        flecha.ImageColor3 = color
        flecha.Visible = true
        flecha.Parent = self.Gui
        escalaFlecha = Instance.new("UIScale")
        escalaFlecha.Scale = 1
        escalaFlecha.Parent = flecha
        if datos.MostrarTextoDistancia ~= false then
            etiquetaDistancia = Instance.new("TextLabel")
            etiquetaDistancia.Name = "TextoDistancia"
            etiquetaDistancia.Size = UDim2.fromOffset(90, 24)
            etiquetaDistancia.Position = UDim2.new(0.5, 0, 1, 0)
            etiquetaDistancia.AnchorPoint = Vector2.new(0.5, 0)
            etiquetaDistancia.BackgroundTransparency = 1
            etiquetaDistancia.TextColor3 = color
            etiquetaDistancia.TextSize = 18
            etiquetaDistancia.Font = Enum.Font.Montserrat
            etiquetaDistancia.Parent = flecha
        end
    end
    local etiqueta
    if datos.MostrarEtiqueta then
        etiqueta = Instance.new("BillboardGui")
        etiqueta.Name = "Etiqueta_" .. HttpService:GenerateGUID(false)
        etiqueta.Size = UDim2.fromOffset(100, 40)
        etiqueta.StudsOffset = Vector3.new(0, 2, 0)
        etiqueta.AlwaysOnTop = true
        etiqueta.MaxDistance = 99999
        etiqueta.Adornee = objetivo
        etiqueta.Parent = self.Gui
        local texto = Instance.new("TextLabel")
        texto.Name = "Texto"
        texto.Size = UDim2.fromScale(1, 1)
        texto.BackgroundTransparency = 1
        texto.TextScaled = true
        texto.TextWrapped = true
        texto.Font = Enum.Font.SourceSansBold
        texto.TextColor3 = color
        texto.Text = datos.TextoEtiqueta or "Objetivo"
        texto.Parent = etiqueta
        Instance.new("UIStroke").Parent = texto
    end
    self.Indicators[objetivo] = {
        Resaltado = resaltado,
        Flecha = flecha,
        EscalaFlecha = escalaFlecha,
        EtiquetaDistancia = etiquetaDistancia,
        Etiqueta = etiqueta,
        Datos = datos
    }
    if datos.NombreGrupo then
        local grupo = self:AgregarGrupo(datos.NombreGrupo)
        table.insert(grupo.objetivos, objetivo)
        if not grupo.habilitado then
            resaltado.Enabled = false
            if flecha then flecha.Visible = false end
            if etiqueta then etiqueta.Enabled = false end
        end
    end
end
function ESP:Eliminar(objetivo)
    local indicador = self.Indicators[objetivo]
    if not indicador then return end
    if indicador.Resaltado then indicador.Resaltado:Destroy() end
    if indicador.Flecha then indicador.Flecha:Destroy() end
    if indicador.Etiqueta then indicador.Etiqueta:Destroy() end
    for _, grupo in pairs(self.Groups) do
        for i = #grupo.objetivos, 1, -1 do
            if grupo.objetivos[i] == objetivo then table.remove(grupo.objetivos, i) end
        end
    end
    self.Indicators[objetivo] = nil
end
function ESP:EliminarGrupo(nombre)
    local grupo = self.Groups[nombre]
    if not grupo then return end
    local objetivos = table.clone(grupo.objetivos)
    for _, obj in ipairs(objetivos) do self:Eliminar(obj) end
    self.Groups[nombre] = nil
end
function ESP:LimpiarTodosGrupos()
    local lista = {}
    for nombre in pairs(self.Groups) do table.insert(lista, nombre) end
    for _, nombre in ipairs(lista) do self:EliminarGrupo(nombre) end
end
function ESP:Actualizar()
    local camara = Workspace.CurrentCamera
    if not camara then return end
    local tamPantalla = camara.ViewportSize
    local margen = 50
    for objetivo, ind in pairs(self.Indicators) do
        if ind.Flecha and ind.EscalaFlecha then
            local pos
            if objetivo:IsA("Model") then
                pos = objetivo.PrimaryPart and objetivo.PrimaryPart.Position or objetivo:GetPivot().Position
            elseif objetivo:IsA("BasePart") then
                pos = objetivo.Position
            end
            if pos then
                local coord, visible = camara:WorldToViewportPoint(pos)
                local distancia = (camara.CFrame.Position - pos).Magnitude
                local distMinFlecha = ind.Datos.DistanciaMinimaFlecha or 0
                if visible and distancia > distMinFlecha then
                    ind.EscalaFlecha.Scale = 0
                else
                    local centro = Vector2.new(tamPantalla.X/2, tamPantalla.Y/2)
                    local espacioCamara = camara.CFrame:VectorToObjectSpace(pos - camara.CFrame.Position)
                    local plano = Vector2.new(espacioCamara.X, espacioCamara.Y)
                    if plano.Magnitude > 0 then
                        plano = plano.Unit
                        local ancho = math.max(tamPantalla.X - margen*2, 1)
                        local alto = math.max(tamPantalla.Y - margen*2, 1)
                        local desplazamiento
                        if math.abs(plano.Y) > alto / math.max(ancho, 1) then
                            desplazamiento = plano * math.abs((alto/2)/math.max(math.abs(plano.Y), 0.001))
                        else
                            desplazamiento = plano * math.abs((ancho/2)/math.max(math.abs(plano.X), 0.001))
                        end
                        ind.Flecha.Position = UDim2.fromOffset(centro.X+desplazamiento.X, centro.Y-desplazamiento.Y)
                        ind.Flecha.Rotation = math.deg(math.atan2(plano.X, plano.Y))
                        ind.EscalaFlecha.Scale = 1
                        if ind.EtiquetaDistancia then
                            ind.EtiquetaDistancia.Text = string.format("%dm", math.round(distancia))
                        end
                    end
                end
            end
        end
    end
end
