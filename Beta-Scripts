local function FindNearestPlayer()
    local near, distMin = nil, math.huge
    local chr = LocalPlayer.Character
    local root = chr and chr:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            local troot = p.Character:FindFirstChild("HumanoidRootPart")
            if troot then
                local d = (root.Position - troot.Position).Magnitude
                if d < distMin then distMin = d; near = p end
            end
        end
    end
    return near
end
local function GetClosestModelToPlayer(pl, mods)
    if not pl.Character then return nil end
    local root = pl.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(mods) do
        local pos = m:IsA("Model") and m:GetPivot().Position or m.Position
        local d = (pos - root.Position).Magnitude
        if d < bestD then bestD = d; best = m end
    end
    return best
end
local function GetPredictedPosition(pl, off)
    if not pl or not pl.Character then return Vector3.zero end
    local chr = pl.Character
    local hrp = chr:FindFirstChild("UpperTorso") or chr:FindFirstChild("HumanoidRootPart")
    local hum = chr:FindFirstChild("Humanoid")
    if not hrp or not hum then return Vector3.zero end
    if predictionAIEngine and not predictionOngoing and not predictionCooldown then
        local net = getgenv().ChitukHubNetwork
        if net and type(net.predictPos) == "function" then
            local lchr = LocalPlayer.Character
            local ltorso = lchr and (lchr:FindFirstChild("UpperTorso") or lchr:FindFirstChild("HumanoidRootPart"))
            if ltorso and (hrp.Position - ltorso.Position).Magnitude > 20 then
                predictionCooldown = true; predictionOngoing = true
                local ok, res = pcall(function() return net.predictPos(pl) end)
                predictionOngoing = false
                task.delay(5, function() predictionCooldown = false end)
                if ok and typeof(res)=="Vector3" then return res end
            end
        end
    end
    local vel = hrp.AssemblyLinearVelocity
    local dirMov = hum.MoveDirection
    local predPos = hrp.Position + vel*Vector3.new(0.75,0.5,0.75)*(off/15) + dirMov*off
    predPos *= ((LocalPlayer:GetNetworkPing()*1000)*((offsetToPingMult-1)*0.01)+1)
    return predPos
end
