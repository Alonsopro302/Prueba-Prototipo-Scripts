local function AlternarAuraMuerte(valor)
    if killAuraConnection then killAuraConnection:Disconnect(); killAuraConnection=nil end
    if not valor then return end
    killAuraConnection=RunService.Heartbeat:Connect(function()
        if EncontrarAsesino()~=LocalPlayer then return end
        var persAura=LocalPlayer.Character
        var raizAura=persAura and persAura:FindFirstChild("HumanoidRootPart")
        var armaAura=persAura and persAura:FindFirstChild("Knife")
        var eventoAtaque=armaAura and armaAura:FindFirstChild("Stab")
        if not raizAura or not eventoAtaque then return end
        for _,jugAura in ipairs(Players:GetPlayers()) do
            if jugAura~=LocalPlayer and jugAura.Character then
                var raizJugAura=jugAura.Character:FindFirstChild("HumanoidRootPart")
                if raizJugAura and (raizAura.Position - raizJugAura.Position).Magnitude <7 then
                    raizJugAura.Anchored=true
                    raizJugAura.CFrame=raizAura.CFrame + raizAura.CFrame.LookVector*2
                    task.wait(0.1)
