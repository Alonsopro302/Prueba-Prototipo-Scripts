local function findNearestPlayer()
local nearestPlayer
local shortestDistance = math.huge
local character = LocalPlayer.Character
local localRoot = character and character:FindFirstChild("HumanoidRootPart")

if not localRoot then
return
end

for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer and player.Character then
local root = player.Character:FindFirstChild("HumanoidRootPart")

if root then
local distance = (localRoot.Position - root.Position).Magnitude

if distance < shortestDistance then
shortestDistance = distance
nearestPlayer = player
end
end
end
end

return nearestPlayer
end

local function miniFling(targetPlayer)
if not targetPlayer or not targetPlayer.Character then
notify("No valid character of the selected player.")
return
end

local localCharacter = LocalPlayer.Character
local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
local localRoot = localHumanoid and localHumanoid.RootPart
local targetCharacter = targetPlayer.Character

if not localRoot or not localHumanoid then
notify("Your character is not valid.")
return
end

local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
local targetRoot = targetHumanoid and targetHumanoid.RootPart
local targetHead = targetCharacter:FindFirstChild("Head")
local accessory = targetCharacter:FindFirstChildOfClass("Accessory")
local accessoryHandle = accessory and accessory:FindFirstChild("Handle")

if not targetCharacter:FindFirstChildWhichIsA("BasePart") then
notify("Target has no valid body part.")
return
end

local oldPosition = localRoot.CFrame
local oldDestroyHeight = workspace.FallenPartsDestroyHeight

workspace.FallenPartsDestroyHeight = -math.huge

local bodyVelocity = Instance.new("BodyVelocity")
bodyVelocity.Name = "YARHM_MM2_FlingVelocity"
bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
bodyVelocity.Velocity = Vector3.new(9e8, 9e8, 9e8)
bodyVelocity.Parent = localRoot

local targetPart = targetHead or targetRoot or accessoryHandle

if not targetPart then
bodyVelocity:Destroy()
workspace.FallenPartsDestroyHeight = oldDestroyHeight
notify("Can't find a proper part of the target.")
return
end

local started = os.clock()

while os.clock() - started < 2 and targetPart.Parent and localRoot.Parent and targetHumanoid and targetHumanoid.Health > 0 do
local targetVelocity = targetPart.AssemblyLinearVelocity

if targetVelocity.Magnitude < 50 and targetHumanoid then
local moveDirection = targetHumanoid.MoveDirection
local speed = math.max(targetHumanoid.WalkSpeed, 16)

local offsets = {
CFrame.new(0, 1.5, 0),
CFrame.new(0, -1.5, 0),
CFrame.new(2.25, 1.5, -2.25),
CFrame.new(-2.25, -1.5, 2.25)
}

for _, offset in ipairs(offsets) do
if not targetPart.Parent then
break
end

local cf = CFrame.new(targetPart.Position) * offset + moveDirection * speed / 1.25

localRoot.CFrame = cf
localRoot.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
localRoot.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)

task.wait()
end
else
localRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1.5, 0))
localRoot.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
localRoot.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
task.wait()
end
end

bodyVelocity:Destroy()

if localHumanoid then
localHumanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
end

workspace.CurrentCamera.CameraSubject = localHumanoid

for _ = 1, 30 do
if not localRoot.Parent then
break
end

localRoot.CFrame = oldPosition * CFrame.new(0, 0.5, 0)
localRoot.AssemblyLinearVelocity = Vector3.zero
localRoot.AssemblyAngularVelocity = Vector3.zero

task.wait()

if (localRoot.Position - oldPosition.Position).Magnitude < 25 then
break
end
end

workspace.FallenPartsDestroyHeight = oldDestroyHeight
end

local function getPredictedPosition(player, offset)
if not player or not player.Character then
return Vector3.zero
end

local character = player.Character
local upperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
local humanoid = character:FindFirstChildOfClass("Humanoid")

if not upperTorso or not humanoid then
return Vector3.zero
end

if predictionAIEngine and not predictionOngoing and not predictionCooldown and type(getgenv().YARHMNetwork_predictPos) == "function" then
local localUpperTorso = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))

if localUpperTorso and (upperTorso.Position - localUpperTorso.Position).Magnitude > 20 then
predictionCooldown = true
predictionOngoing = true

local ok, predicted = pcall(getgenv().YARHMNetwork_predictPos, player)

predictionOngoing = false

task.delay(5, function()
predictionCooldown = false
end)

if ok and typeof(predicted) == "Vector3" then
return predicted
end
end
end

local velocity = upperTorso.AssemblyLinearVelocity
local moveDirection = humanoid.MoveDirection

local predicted = upperTorso.Position + velocity * Vector3.new(0.75, 0.5, 0.75) * (offset / 15) + moveDirection * offset
local pingAdjustment = ((LocalPlayer:GetNetworkPing() * 1000) * ((offsetToPingMult - 1) * 0.01)) + 1

return predicted * pingAdjustment
end

