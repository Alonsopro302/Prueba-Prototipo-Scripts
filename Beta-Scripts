-- Funciones ESP mejoradas
function ReloadESP()
    for _,g in pairs(ESPContainer) do if type(g)=="table" and g.Destroy then g:Destroy() end end
    ESPContainer = {}
    if not playerESP then return end
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl~=LocalPlayer and not (pl.Character and pl.Character:FindFirstChild("HideMyESP")) then
            local m = FindMurderer()
            local s = FindSheriff()
            local color = pl==m and Color3.new(1,0,0) or pl==s and Color3.new(0,1,0) or Color3.new(1,1,1)
            if pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
                local part = pl.Character.HumanoidRootPart
                ESPContainer[pl.Name] = {
                    Object = part,
                    Color = color,
                    Label = pl.DisplayName
                }
            end
        end
    end
end

function ESPContainer:RemoveGroup(name)
    for k in pairs(self) do if type(k)=="string" and k:find(name) then self[k]=nil end end
end

function ESPContainer:ClearAllGroups()
    for k in pairs(self) do self[k]=nil end
end

function ESPContainer:Add(part, opts)
    self[part.Name..opts.LabelText] = {Part=part,Options=opts}
end

-- Funciones de roles
local function FindMurderer()
    for _,pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        if ch and ch:FindFirstChild("Knife") and not ch:FindFirstChild("Gun") then return pl end
    end
    return nil
end

local function FindSheriff()
    for _,pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        if ch and ch:FindFirstChild("Gun") then return pl end
    end
    return nil
end

local function FindSheriffNotMe()
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl~=LocalPlayer and pl.Character and pl.Character:FindFirstChild("Gun") then return pl end
    end
    return nil
end

local function FindNearestPlayer()
    local chr = LocalPlayer.Character
    local root = chr and chr:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local distMin = math.huge
    local target = nil
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl~=LocalPlayer and pl.Character then
            local troot = pl.Character:FindFirstChild("HumanoidRootPart")
            if troot then
                local d = (root.Position - troot.Position).Magnitude
                if d < distMin then distMin = d target = pl end
            end
        end
    end
    return target
end

local function GetMap()
    for _,obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:find("Map_") or obj:FindFirstChild("Spawns") then return obj end
    end
    return nil
end

-- Posición de predicción mejorada y estable
local function GetPredictedPosition(pl, off)
    local chr = LocalPlayer.Character
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not hum then return Vector3.zero end
    if predictionAIEngine and not predictionOngoing and not predictionCooldown then
        local net = getgenv().DarkHubNetwork
        if net and type(net.predictPos)=="function" then
            local lchr = LocalPlayer.Character
            local ltorso = lchr and (lchr:FindFirstChild("UpperTorso") or lchr:FindFirstChild("HumanoidRootPart"))
            if ltorso and (hrp.Position - ltorso.Position).Magnitude > 20 then
                predictionCooldown = true predictionOngoing = true
                local ok, res = pcall(function() return net.predictPos(pl) end)
                predictionOngoing = false
                task.delay(5, function() predictionCooldown = false end)
                if ok and typeof(res)=="Vector3" then return res end
            end
        end
    end
    local vel = hrp.AssemblyLinearVelocity
    local dirMov = hum.MoveDirection
    local predPos = hrp.Position + vel*Vector3.new(0.75,0.5,0.75)*(off/15) + dirMov*off
    predPos *= ((LocalPlayer:GetNetworkPing()*1000)*((offsetToPingMult-1)*0.01)+1)
    return predPos
end

local function EquipTool(name)
    local chr = LocalPlayer.Character
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    if not chr or not hum then Notify("Invalid character"); return false end
    if chr:FindFirstChild(name) then return true end
    local tool = LocalPlayer.Backpack:FindFirstChild(name)
    if not tool then Notify("Missing tool: "..name); return false end
    hum:EquipTool(tool)
    return chr:FindFirstChild(name)~=nil
end

-- Funciones de ataque y movimiento
local function ShootMurderer()
    if FindSheriff()~=LocalPlayer then Notify("You are not Sheriff"); return end
    local tgt = FindMurderer() or FindSheriffNotMe()
    if not tgt or not tgt.Character then Notify("Target not found"); return end
    if not EquipTool("Gun") then return end
    local chr = LocalPlayer.Character
    local rh = chr and chr:FindFirstChild("RightHand")
    local troot = tgt.Character:FindFirstChild("HumanoidRootPart")
    local gun = chr:FindFirstChild("Gun")
    local rem = gun and gun:FindFirstChild("Shoot")
    if not rh or not troot or not rem then Notify("Missing weapon parts"); return end
    local pred = GetPredictedPosition(tgt, shootOffset)
    local args
    if instakillshoot then
        args={CFrame.new(troot.Position+Vector3.new(0,1,0)), CFrame.new(troot.Position)}
    else
        args={CFrame.new(rh.Position), CFrame.new(pred)}
    end
    rem:FireServer(unpack(args))
end

local function KnifeThrow(silent)
    if FindMurderer()~=LocalPlayer then if not silent then Notify("You are not Murderer") end; return end
    if not EquipTool("Knife") then return end
    local near = FindNearestPlayer()
    if not near or not near.Character then if not silent then Notify("No target nearby") end; return end
    local chr = LocalPlayer.Character
    local rh = chr and chr:FindFirstChild("RightHand")
    local nroot = near.Character:FindFirstChild("HumanoidRootPart")
    local knife = chr:FindFirstChild("Knife")
    local ev = knife and knife:FindFirstChild("Events")
    local rem = ev and ev:FindFirstChild("KnifeThrown")
    if not rh or not nroot or not rem then Notify("Knife incomplete"); return end
    local posP = GetPredictedPosition(near, shootOffset+1)
    local args={CFrame.new(rh.Position), CFrame.new(posP)}
    if spawnAtPlayer then args[1] = CFrame.new(nroot.Position + nroot.CFrame.LookVector*5) end
    rem:FireServer(unpack(args))
end

-- Teleportaciones
local function TeleportToLobby()
    local lobby = workspace:FindFirstChild("Lobby")
    local chr = LocalPlayer.Character
    if not lobby or not chr then Notify("Lobby not found"); return end
    local spawns = lobby:FindFirstChild("Spawns")
    local sp = spawns and spawns:FindFirstChildWhichIsA("SpawnLocation")
