    local tgt = FindMurderer() or FindSheriffNotMe()
    if not tgt or not tgt.Character then Notify("Objetivo no encontrado"); return end
    if not EquipTool("Gun") then return end
    local chr = LocalPlayer.Character
    local rh = chr and chr:FindFirstChild("RightHand")
    local troot = tgt.Character:FindFirstChild("HumanoidRootPart")
    local gun = chr:FindFirstChild("Gun")
    local rem = gun and gun:FindFirstChild("Shoot")
    if not rh or not troot or not rem then Notify("Partes del arma faltantes"); return end
    local pred = GetPredictedPosition(tgt, shootOffset)
