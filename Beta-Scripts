-- Disparo automático
local function ToggleAutoShoot(v)
    autoShooting=v
    if autoShootTask then task.cancel(autoShootTask); autoShootTask=nil end
    if not v then return end
    autoShootTask=task.spawn(function()
        while autoShooting do
            task.wait(0.12)
            if FindSheriff()==LocalPlayer then
                local m=FindMurderer()
                if m and m.Character then
                    local c=LocalPlayer.Character
                    local mroot=m.Character:FindFirstChild("HumanoidRootPart")
                    local croot=c and c:FindFirstChild("HumanoidRootPart")
                    if mroot and croot then
                        local dir=mroot.Position - croot.Position
                        local rayP=RaycastParams.new()
                        rayP.FilterType=Enum.RaycastFilterType.Exclude
                        rayP.FilterDescendantsInstances={c}
                        local hit=workspace:Raycast(croot.Position,dir,rayP)
                        if not hit or hit.Instance:IsDescendantOf(m.Character) then
                            if EquipTool("Gun") then
                                local gun=c:FindFirstChild("Gun")
                                local kl=gun and gun:FindFirstChild("KnifeLocal")
                                local cb=kl and kl:FindFirstChild("CreateBeam")
                                local rem=cb and cb:FindFirstChild("RemoteFunction")
                                if rem and rem:IsA("RemoteFunction") then
                                    local pred=GetPredictedPosition(m, shootOffset)
                                    pcall(function() rem:InvokeServer(1,pred,"AH2") end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function DelayedShoot()
    if FindSheriff()~=LocalPlayer then Notify("You are not Sheriff"); return end
    local obj=FindMurderer() or FindSheriffNotMe()
    if not obj or not obj.Character then Notify("No target found"); return end
    if not EquipTool("Gun") then return end
    local c=LocalPlayer.Character
    local r=c and c:FindFirstChild("HumanoidRootPart")
    local mr=obj.Character:FindFirstChild("HumanoidRootPart")
    if not r or not mr then Notify("Invalid root parts"); return end
    Notify("Waiting for clear line of sight...")
    local conn
    conn=RunService.Heartbeat:Connect(function()
        if not obj.Parent or not obj.Character or not mr.Parent then conn:Disconnect(); return end
        local orig=r.Position
        local dir=Vector3.new(mr.Position.X, orig.Y, mr.Position.Z)-orig
        if dir.Magnitude<=0 then return end
        local res=workspace:Raycast(orig, dir.Unit*1500, RaycastParams.new():WithFilterDescendantsInstances({LocalPlayer.Character}))
        if res and res.Instance:IsDescendantOf(obj.Character) then
            local gun=c:FindFirstChild("Gun")
            local kl=gun and gun:FindFirstChild("KnifeLocal")
            local cb=kl and kl:FindFirstChild("CreateBeam")
            local rem=cb and cb:FindFirstChild("RemoteFunction")
            if rem then
                local pred=GetPredictedPosition(obj, shootOffset)
                pcall(function() rem:InvokeServer(1,pred,"AH2") end)
            end
            conn:Disconnect()
        end
    end)
end

-- Recolección monedas
local function ToggleCoinAutoCollect(v)
    coinAutoCollect = v
    if coinLoop then coinLoop:Disconnect(); coinLoop = nil end
    if not coinAutoCollect then return end
    coinLoop = RunService.Heartbeat:Connect(function()
        local map = GetMap()
        if not map then return end
        local container = map:FindFirstChild("CoinContainer")
        if not container then return end
        local coins = container:GetChildren()
        if #coins < 1 then return end
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local closest, minDist = nil, math.huge
        for _, coin in ipairs(coins) do
            local pos = coin:IsA("Model") and coin:GetPivot().Position or coin.Position
            local dist = (root.Position - pos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
        if closest then
            root.CFrame = CFrame.new(closest.Position)
            task.wait(0.15)
        end
    end)
end

-- Matar
local function KillClosest()
    if FindMurderer()~=LocalPlayer then Notify("Murderer only"); return end
    if not EquipTool("Knife") then return end
    local cer=FindNearestPlayer()
    if not cer or not cer.Character then Notify("No nearby target"); return end
    local chr = LocalPlayer.Character
    local r=chr and chr:FindFirstChild("HumanoidRootPart")
    local tr=cer.Character:FindFirstChild("HumanoidRootPart")
    local k=chr:FindFirstChild("Knife")
    local st=k and k:FindFirstChild("Stab")
    if not r or not tr or not st then Notify("Missing attack elements"); return end
    tr.Anchored=true
    tr.CFrame=r.CFrame + r.CFrame.LookVector*2
    task.wait(0.1)
    st:FireServer("Slash")
end

local function KillEveryone()
    if FindMurderer()~=LocalPlayer then Notify("Murderer only"); return end
    if not EquipTool("Knife") then return end
    local chr = LocalPlayer.Character
    local r=chr and chr:FindFirstChild("HumanoidRootPart")
    local k=chr:FindFirstChild("Knife")
    local st=k and k:FindFirstChild("Stab")
    if not r or not st then Notify("Incomplete setup"); return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            local pr=p.Character:FindFirstChild("HumanoidRootPart")
            if pr then pr.Anchored=true; pr.CFrame=r.CFrame + r.CFrame.LookVector end
        end
    end
    st:FireServer("Slash")
end

local function ToggleKillAura(v)
    if killAuraConnection then killAuraConnection:Disconnect(); killAuraConnection=nil end
    if not v then return end
    killAuraConnection=RunService.Heartbeat:Connect(function()
        if FindMurderer()~=LocalPlayer then return end
        local c=LocalPlayer.Character
        local r=c and c:FindFirstChild("HumanoidRootPart")
        local k=c and c:FindFirstChild("Knife")
        local st=k and k:FindFirstChild("Stab")
        if not r or not st then return end
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                local pr=p.Character:FindFirstChild("HumanoidRootPart")
                if pr and (pr.Position - r.Position).Magnitude <7 then
                    pr.Anchored=true
                    pr.CFrame=r.CFrame + r.CFrame.LookVector*2
                    task.wait(0.1)
                    if st:IsA("RemoteEvent") then st:FireServer("Slash") end
                    break
                end
            end
        end
    end)
end

-- GodMode
local function GodMode()
    local cam=workspace.CurrentCamera
    local c=LocalPlayer.Character
    local hum=c and c:FindFirstChildOfClass("Humanoid")
    if not cam or not c or not hum then Notify("Invalid character"); return end
    local posCam=cam.CFrame
    local nh=hum:Clone()
    nh.Parent=c
    LocalPlayer.Character=nil
    hum:Destroy()
    LocalPlayer.Character=c
    cam.CameraSubject=nh
    cam.CFrame=posCam
    nh:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
    nh:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    nh:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
    nh.BreakJointsOnDeath=true
    nh.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    local anim=c:FindFirstChild("Animate")
    if anim then anim.Disabled=true; task.wait(); anim.Disabled=false end
    nh.Health=nh.MaxHealth
end

