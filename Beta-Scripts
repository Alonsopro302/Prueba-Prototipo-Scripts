-- Sistema CONFIG JSON mejorado totalmente funcional
local function SaveConfigAsJson(name)
    if not name or type(name)~="string" or name:gsub("%s","")=="" then Notify("Enter valid name"); return end
    local cfg={
        SpeedMult=speedMultiplier,
        AntiFling=antiFlingEnabled,
        PlayerESP=playerESP,
        GunESP=gunDropESP,
        TrapESP=trapDetection,
        AutoShoot=autoShooting,
        Instakill=instakillshoot,
        ShootOffset=shootOffset,
        PingMult=offsetToPingMult,
        AIPrediction=predictionAIEngine,
        AutoKnifeThrow=loopThrow,
        SpawnKnifeNear=spawnAtPlayer,
        KillAura=killAuraConnection~=nil,
        AutoGun=autoGetDroppedGun,
        IgnoreKnife=ignoreKnifeThrow,
        AutoCoins=coinAutoCollect,
        RoundTimer=timerTask~=nil
    }
    local ok, res=pcall(function() return HttpService:JSONEncode(cfg) end)
    if ok then
        writefile("DarkHub_MM2_"..name..".json", res)
        Notify("Saved config: "..name)
    else
        Notify("Failed to encode config")
    end
end

local function LoadConfigFromJson(name)
    if not name or type(name)~="string" or name:gsub("%s","")=="" then Notify("Enter valid name"); return end
    local path="DarkHub_MM2_"..name..".json"
    if not isfile(path) then Notify("Config not found"); return end
    local ok, dat=pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(dat)~="table" then Notify("Invalid/corrupted config"); return end
    pcall(function() SetSpeed(tonumber(dat.SpeedMult) or 1) end)
    pcall(function() ToggleAntiFling(dat.AntiFling==true) end)
    pcall(function() TogglePlayerESP(dat.PlayerESP==true) end)
    pcall(function() ToggleGunESP(dat.GunESP==true) end)
    pcall(function() ToggleTrapESP(dat.TrapESP==true) end)
    pcall(function() ToggleAutoShoot(dat.AutoShoot==true) end)
    instakillshoot=(dat.Instakill==true)
    shootOffset=tonumber(dat.ShootOffset) or 2.8
    offsetToPingMult=tonumber(dat.PingMult) or 1
    predictionAIEngine=(dat.AIPrediction==true)
    loopThrow=(dat.AutoKnifeThrow==true)
    spawnAtPlayer=(dat.SpawnKnifeNear==true)
    pcall(function() ToggleKillAura(dat.KillAura==true) end)
    autoGetDroppedGun=(dat.AutoGun==true)
    ignoreKnifeThrow=(dat.IgnoreKnife==true)
    pcall(function() ToggleCoinAutoCollect(dat.AutoCoins==true) end)
    pcall(function() ToggleRoundTimer(dat.RoundTimer==true) end)
    Notify("Loaded config: "..name)
end

local function ListConfigs()
    local list={}
    for _,f in ipairs(listfiles()) do
        local pref="DarkHub_MM2_"
        if f:sub(1,#pref)==pref and f:sub(-5)==".json" then
            local nm=f:sub(#pref+1, #f-5)
            table.insert(list, nm)
        end
    end
    if #list==0 then Notify("No config files found") else Notify("Available configs: "..table.concat(list, ", ")) end
end

