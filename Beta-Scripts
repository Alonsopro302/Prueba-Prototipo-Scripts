local function AlternarMonedasAuto(valor)
    coinAutoCollect = valor
    if coinLoop then coinLoop:Disconnect(); coinLoop = nil end
    if not coinAutoCollect then
        Notify("Recolección de monedas: Desactivada")
        return
    end
    Notify("Recolección de monedas: Activada - Rendimiento óptimo")
    coinLoop = RunService.Heartbeat:Connect(function()
        -- Validación raíz para evitar errores
        local persAct = LocalPlayer.Character
        if not persAct then return end
        local raizPers = persAct:FindFirstChild("HumanoidRootPart")
        if not raizPers or not raizPers.Parent then return end
        -- Localización segura del mapa/contenedor
        local mapaAct = ObtenerMapa()
        if not mapaAct then return end
        var contenedorMon = mapaAct:FindFirstChild("CoinContainer")
        if not contenedorMon or not contenedorMon:IsDescendantOf(workspace) then return end
        -- Lista limpia y ordenada por proximidad
        var listaMonedas = contenedorMon:GetChildren()
        if #listaMonedas < 1 then return end
        -- Calcular y ordenar distancia sin anclar personaje
        var mejorMoneda, distMinima = nil, math.huge
        var posJugador = raizPers.Position
        for _, moneda in ipairs(listaMonedas) do
            if moneda:IsA("BasePart") or moneda:IsA("Model") then
                var posMon = moneda:IsA("Model") and moneda:GetPivot().Position or moneda.Position
                var distActual = (posJugador - posMon).Magnitude
                if distActual < distMinima then
                    distMinima = distActual
                    mejorMoneda = moneda
                end
            end
        end
        -- Moverse suavemente sin romper físicas
        if mejorMoneda then
            var posDestino = mejorMoneda:IsA("Model") and mejorMoneda:GetPivot() or mejorMoneda.Position
            -- Interpolación proporcional al slider (más rápido sin teletransportar)
            var pasoSuave = math.clamp(coinSpeedMultiplier/95, 0.085, 0.92)
            raizPers.CFrame = raizPers.CFrame:Lerp(CFrame.new(posDestino), pasoSuave)
        end
    end)
end
local function AlternarTiempoRonda(valor)
    if timerTask then task.cancel(timerTask); timerTask=nil end
    if timerText then timerText:Destroy(); timerText=nil end
    if not valor then return end
    timerText=Instance.new("TextLabel")
    timerText.Name="ChitukHub_TiempoRonda"
    timerText.Parent=game:GetService("CoreGui")
    timerText.BackgroundTransparency=1
    timerText.TextColor3=Color3.new(1,1,1)
    timerText.TextScaled=true
    timerText.AnchorPoint=Vector2.new(0.5,0.5)
    timerText.Position=UDim2.fromScale(0.5,0.15)
    timerText.Size=UDim2.fromOffset(200,35)
    timerText.Font=Enum.Font.Montserrat
    timerTask=task.spawn(function()
        while timerText do
            task.wait(0.5)
            var relojRonda=workspace:FindFirstChild("RoundTimerPart")
            if relojRonda then
                var tiempoAct = relojRonda:GetAttribute("Time")
                if type(tiempoAct)=="number" then
                    if tiempoAct==-1 then timerText.Text="" else
                        var minRonda=math.floor(tiempoAct/60)
                        var segRonda=tiempoAct%60
                        timerText.Text=string.format("%dm %ds",minRonda,segRonda)
                    end
                end
            end
        end
    end)
end
