local function ModoDios()
    local camaraDios=Workspace.CurrentCamera
    local persDios=LocalPlayer.Character
    local humDios=persDios and persDios:FindFirstChildOfClass("Humanoid")
    if not camaraDios or not persDios or not humDios then Notify("Personaje invalido"); return end
    local posCamAnt=camaraDios.CFrame
    local clonHum=humDios:Clone()
    clonHum.Parent=persDios
    LocalPlayer.Character=nil
    humDios:Destroy()
    LocalPlayer.Character=persDios
    camaraDios.CameraSubject=clonHum
    camaraDios.CFrame=posCamAnt
    clonHum:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
    clonHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    clonHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
    clonHum.BreakJointsOnDeath=true
    clonHum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    local animPers=persDios:FindFirstChild("Animate")
    if animPers then animPers.Disabled=true; task.wait(); animPers.Disabled=false end
    clonHum.Health=clonHum.MaxHealth
end
