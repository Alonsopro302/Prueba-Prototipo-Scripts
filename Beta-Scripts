local function ActivarInvisibilidad()
    if invisibleActive then return end
    local char = LocalPlayer.Character
    if not char then
        Notify("Necesitas personaje")
        return false
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then
        Notify("Personaje incompleto")
        return false
    end
    invisibleActive = true
    invisibleParts = {}
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency == 0 then
            table.insert(invisibleParts, v)
        end
    end
    for _, v in pairs(invisibleParts) do
        v.Transparency = 0.5
    end
    invisibleOriginalCFrame = root.CFrame
    invisibleOriginalCameraOffset = hum.CameraOffset
    local conn = RunService.Heartbeat:Connect(function()
        if not invisibleActive then return end
        local curChar = LocalPlayer.Character
        if not curChar then return end
        local curRoot = curChar:FindFirstChild("HumanoidRootPart")
        local curHum = curChar:FindFirstChild("Humanoid")
        if not curRoot or not curHum then return end
        local _CFrame = curRoot.CFrame
        local _CameraOffset = curHum.CameraOffset
        local v40 = _CFrame * CFrame.new(0, -200000, 0)
        local _Position = v40:ToObjectSpace(CFrame.new(_CFrame.Position)).Position
        curRoot.CFrame = v40
        curHum.CameraOffset = _Position
        RunService.RenderStepped:Wait()
        curRoot.CFrame = _CFrame
        curHum.CameraOffset = _CameraOffset
    end)
    table.insert(invisibleConnections, conn)
    Notify("Invisibilidad: ACTIVADA")
    return true
end

function DesactivarInvisibilidad()
    invisibleActive = false
    for _, conn in pairs(invisibleConnections) do
        pcall(function() conn:Disconnect() end)
    end
    invisibleConnections = {}
    for _, v in pairs(invisibleParts) do
        if v and v.Parent then
            v.Transparency = 0
        end
    end
    invisibleParts = {}
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum and invisibleOriginalCameraOffset then
            hum.CameraOffset = invisibleOriginalCameraOffset
        end
    end
    invisibleOriginalCFrame = nil
    invisibleOriginalCameraOffset = nil
    Notify("Invisibilidad: DESACTIVADA")
end

local function ToggleInvisibilidad(valor)
    if valor then
        ActivarInvisibilidad()
    else
        DesactivarInvisibilidad()
    end
end

local function ActivarAimBot()
    if aimBotActive then return end
    aimBotActive = true
    aimBotLoop = task.spawn(function()
        while aimBotActive do
            pcall(function()
                if getPlayerRole(LocalPlayer) == "Sheriff" then
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    local murderer = nil
                    local murdererHead = nil
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local role = getPlayerRole(p)
                            if role == "Murderer" then
                                local head = p.Character:FindFirstChild("Head")
                                if head then
                                    murderer = p
                                    murdererHead = head
                                    break
                                end
                            end
                        end
                    end
                    if murderer and murdererHead then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, murdererHead.Position)
                    end
                end
            end)
            task.wait()
        end
    end)
    Notify("Aim Bot Murder: ACTIVADO")
end

local function DesactivarAimBot()
    aimBotActive = false
    if aimBotLoop then
        task.cancel(aimBotLoop)
        aimBotLoop = nil
    end
    Notify("Aim Bot Murder: DESACTIVADO")
end

local function ToggleAimBot(valor)
    if valor then
        ActivarAimBot()
    else
        DesactivarAimBot()
    end
end

