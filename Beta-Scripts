function ESP.new()
    local self = setmetatable({}, ESP)

    self.Groups = {}
    self.TargetIndex = {}
    self.Indicators = {}

    self.Gui = Instance.new("ScreenGui")
    self.Gui.Name = "DarkHub_MM2_ESP"
    self.Gui.ResetOnSpawn = false
    self.Gui.IgnoreGuiInset = true
    self.Gui.Parent = game:GetService("CoreGui")

    self.ArrowTemplate = Instance.new("ImageLabel")
    self.ArrowTemplate.Name = "ArrowTemplate"
    self.ArrowTemplate.Size = UDim2.fromOffset(40, 40)
    self.ArrowTemplate.AnchorPoint = Vector2.new(0.5, 0.5)
    self.ArrowTemplate.BackgroundTransparency = 1
    self.ArrowTemplate.Image = "rbxassetid://97136202386756"
    self.ArrowTemplate.Visible = false
    self.ArrowTemplate.Parent = self.Gui

    self.Connection = RunService.RenderStepped:Connect(function()
        self:Update()
    end)

    return self
end

function ESP:AddGroup(name)
    if not self.Groups[name] then
        self.Groups[name] = {
            enabled = true,
            targets = {},
            properties = {}
        }
    end

    return self.Groups[name]
end

function ESP:Add(target, data)
    if not target then
        return
    end

    self:Remove(target)

    data = data or {}

    local color = data.AccentColor or Color3.new(1, 1, 0)

    local highlight = Instance.new("Highlight")
    highlight.Name = "DarkHub_" .. HttpService:GenerateGUID(false)
    highlight.Adornee = target
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = data.HighlightFillTransparency or 0.7
    highlight.OutlineTransparency = data.HighlightOutlineTransparency or 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = self.Gui

    local arrow
    local distanceLabel
    local arrowScale

    if data.ArrowShow then
        arrow = self.ArrowTemplate:Clone()
        arrow.Name = "Arrow_" .. HttpService:GenerateGUID(false)
        arrow.ImageColor3 = color
        arrow.Visible = true
        arrow.Parent = self.Gui

        arrowScale = Instance.new("UIScale")
        arrowScale.Scale = 1
        arrowScale.Parent = arrow

        if data.ArrowShowDistanceText ~= false then
            distanceLabel = Instance.new("TextLabel")
            distanceLabel.Name = "DistanceLabel"
            distanceLabel.Size = UDim2.fromOffset(90, 24)
            distanceLabel.Position = UDim2.new(0.5, 0, 1, 0)
            distanceLabel.AnchorPoint = Vector2.new(0.5, 0)
            distanceLabel.BackgroundTransparency = 1
            distanceLabel.TextColor3 = color
            distanceLabel.TextSize = 18
            distanceLabel.Font = Enum.Font.Montserrat
            distanceLabel.Parent = arrow
        end
    end

    local label

    if data.ShowLabel then
        label = Instance.new("BillboardGui")
        label.Name = "Label_" .. HttpService:GenerateGUID(false)
        label.Size = UDim2.fromOffset(100, 40)
        label.StudsOffset = Vector3.new(0, 2, 0)
        label.AlwaysOnTop = true
        label.MaxDistance = 99999
        label.Adornee = target
        label.Parent = self.Gui

        local text = Instance.new("TextLabel")
        text.Name = "TextLabel"
        text.Size = UDim2.fromScale(1, 1)
        text.BackgroundTransparency = 1
        text.TextScaled = true
        text.TextWrapped = true
        text.Font = Enum.Font.SourceSansBold
        text.TextColor3 = color
        text.Text = data.LabelText or "Target"
        text.Parent = label

        local stroke = Instance.new("UIStroke")
        stroke.Parent = text
    end

    self.Indicators[target] = {
        Highlight = highlight,
        Arrow = arrow,
        ArrowScale = arrowScale,
        DistanceLabel = distanceLabel,
        Label = label,
        Data = data
    }

    if data.GroupName then
        local group = self:AddGroup(data.GroupName)

        table.insert(group.targets, target)

        if group.enabled == false then
            highlight.Enabled = false

            if arrow then
                arrow.Visible = false
            end

            if label then
                label.Enabled = false
            end
        end
    end
end

function ESP:Remove(target)
    local indicator = self.Indicators[target]

    if not indicator then
        return
    end

    if indicator.Highlight then
        indicator.Highlight:Destroy()
    end

    if indicator.Arrow then
        indicator.Arrow:Destroy()
    end

    if indicator.Label then
        indicator.Label:Destroy()
    end

    for _, group in pairs(self.Groups) do
        for i = #group.targets, 1, -1 do
            if group.targets[i] == target then
                table.remove(group.targets, i)
            end
        end
    end

    self.Indicators[target] = nil
end

function ESP:RemoveGroup(name)
    local group = self.Groups[name]

    if not group then
        return
    end

    local targets = table.clone(group.targets)

    for _, target in ipairs(targets) do
        self:Remove(target)
    end

    self.Groups[name] = nil
end

function ESP:ClearAllGroups()
    local groups = {}

    for name in pairs(self.Groups) do
        table.insert(groups, name)
    end

    for _, name in ipairs(groups) do
        self:RemoveGroup(name)
    end
end

function ESP:Update()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local padding = 50

    for target, indicator in pairs(self.Indicators) do
        local arrow = indicator.Arrow

        if arrow and indicator.ArrowScale then
            local position

            if target:IsA("Model") then
                position = target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position
            elseif target:IsA("BasePart") then
                position = target.Position
            end

            if position then
                local screenPosition, visible = camera:WorldToViewportPoint(position)
                local distance = (camera.CFrame.Position - position).Magnitude

                if visible and distance > (indicator.Data.ArrowMinDistance or 0) then
                    indicator.ArrowScale.Scale = 0
                else
                    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
                    local direction = camera.CFrame:VectorToObjectSpace(position - camera.CFrame.Position)

                    local flatDirection = Vector2.new(direction.X, direction.Y)

                    if flatDirection.Magnitude > 0 then
                        flatDirection = flatDirection.Unit

                        local width = math.max(viewport.X - padding * 2, 1)
                        local height = math.max(viewport.Y - padding * 2, 1)

                        local offset

                        if math.abs(flatDirection.Y) > height / math.max(width, 1) then
                            offset = flatDirection * math.abs((height / 2) / math.max(math.abs(flatDirection.Y), 0.001))
                        else
                            offset = flatDirection * math.abs((width / 2) / math.max(math.abs(flatDirection.X), 0.001))
                        end

                        arrow.Position = UDim2.fromOffset(
                            center.X + offset.X,
                            center.Y - offset.Y
                        )

                        arrow.Rotation = math.deg(math.atan2(flatDirection.X, flatDirection.Y))
                        indicator.ArrowScale.Scale = 1

                        if indicator.DistanceLabel then
                            indicator.DistanceLabel.Text = string.format("%dm", math.round(distance))
                        end
                    end
                end
            end
        end
    end
end

function ESP:Destroy()
    if self.Connection then
        self.Connection:Disconnect()
    end

    self:ClearAllGroups()

    if self.Gui then
        self.Gui:Destroy()
    end
end

