-- Funciones auxiliares
local function IsRagdoll(m) return Workspace:FindFirstChild("Ragdolls") and m:IsDescendantOf(Workspace.Ragdolls) end
local function RemoveESP(m)
    if not m then return end
    pcall(function()
        if m:FindFirstChild("Pichig_ESP") then m.Pichig_ESP:Destroy() end
        if m:FindFirstChild("Pichig_ESP_Text") then m.Pichig_ESP_Text:Destroy() end
    end)
end
local function CreateESP_Model(model, color, texto)
    if not model or model:FindFirstChild("Pichig_ESP") or IsRagdoll(model) then return end
    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not hrp then return end

    -- Highlight
    local hl = Instance.new("Highlight")
    hl.Name = "Pichig_ESP"
    hl.Adornee = model
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.Parent = model

    -- Texto
    local bg = Instance.new("BillboardGui")
    bg.Name = "Pichig_ESP_Text"
    bg.Adornee = hrp
    bg.AlwaysOnTop = true
    bg.Size = UDim2.new(0, 150, 0, 40)
    bg.StudsOffset = Vector3.new(0, 3.5, 0)
    bg.Parent = model

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = texto or model.Name
    lbl.Font = Enum.Font.GothamBold
    lbl.TextColor3 = color
    lbl.TextSize = 9
    lbl.TextStrokeTransparency = 0
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.Parent = bg
end

-- Actualización principal del ESP
task.spawn(function()
    while task.wait(0.4) do
        -- Limpiar todo primero
        for _,v in pairs(Workspace:GetDescendants()) do
            if v:FindFirstChild("Pichig_ESP") and not ESP_Active[v:GetAttribute("ESP_Type")] then RemoveESP(v) end
        end

        -- === JUGADORES ===
        local PlayersFolder = Workspace:FindFirstChild("Players")
        if PlayersFolder then
            local Killers = PlayersFolder:FindFirstChild("Killers")
            local Survivors = PlayersFolder:FindFirstChild("Survivors")

            -- Killers
            if Killers and ESP_Active.Killer then
                for _,m in ipairs(Killers:GetChildren()) do
                    if m ~= LP.Character and not IsRagdoll(m) then
                        m:SetAttribute("ESP_Type", "Killer")
                        CreateESP_Model(m, ESP_Colors.Killer, "🔪 KILLER\n"..m.Name)
                    end
                end
            end

            -- Survivors
            if Survivors and ESP_Active.Survivor then
                for _,m in ipairs(Survivors:GetChildren()) do
                    if m ~= LP.Character and not IsRagdoll(m) then
                        m:SetAttribute("ESP_Type", "Survivor")
                        CreateESP_Model(m, ESP_Colors.Survivor, "🧑 "..m.Name)
                    end
                end
            end
        end

        -- === OBJETOS ===
        if not MapFolder then continue end
        local Map = MapFolder:FindFirstChild("Map")
        if Map then
            -- Generadores
            if ESP_Active.Generator then
                for _,m in ipairs(Map:GetChildren()) do
                    if m:IsA("Model") and m.Name:lower():find("generator") and m.Name ~= "FakeGenerator" then
                        local prog = m:FindFirstChild("Progress")
                        if prog and prog.Value < 100 then
                            m:SetAttribute("ESP_Type", "Generator")
                            CreateESP_Model(m, ESP_Colors.Generator, "⚡ GENERADOR\n"..math.floor(prog.Value).."%")
                        end
                    end
                end
            end

            -- Items
            if ESP_Active.Item then
                for _,item in ipairs(Map:GetDescendants()) do
                    if item.Name == "ItemRoot" and item.Parent then
                        local m = item.Parent
                        m:SetAttribute("ESP_Type", "Item")
                        CreateESP_Model(m, ESP_Colors.Item, "📦 ITEM")
                    end
                end
            end
        end

        -- Pizza
        if ESP_Active.Pizza then
            for _,v in ipairs(MapFolder:GetChildren()) do
                if v.Name == "Pizza" and v:IsA("BasePart") then
                    v:SetAttribute("ESP_Type", "Pizza")
                    CreateESP_Model(v, ESP_Colors.Pizza, "🍕 PIZZA")
                end
            end
        end

        -- Zombies
        if ESP_Active.Zombie then
            for _,v in ipairs(MapFolder:GetChildren()) do
                if v.Name == "1x1x1x1Zombie" then
                    v:SetAttribute("ESP_Type", "Zombie")
                    CreateESP_Model(v, ESP_Colors.Zombie, "🧟 ZOMBIE")
                end
            end
        end

        -- Minas / Tripwire
        if ESP_Active.Tripwire then
            for _,v in ipairs(MapFolder:GetChildren()) do
                if v.Name:find("Tripwire") then
                    v:SetAttribute("ESP_Type", "Tripwire")
                    CreateESP_Model(v, ESP_Colors.Tripwire, "⚠️ TRIPWIRE")
                end
            end
        end
        if ESP_Active.Mine then
            for _,v in ipairs(MapFolder:GetChildren()) do
                if v.Name == "SubspaceTripmine" then
                    v:SetAttribute("ESP_Type", "Mine")
                    CreateESP_Model(v, ESP_Colors.Mine, "💣 MINA")
                end
            end
        end

        -- Respawn
        if ESP_Active.Respawn then
            for _,v in ipairs(MapFolder:GetDescendants()) do
                if v.Name:lower():find("respawnlocation") then
                    local m = v:IsA("BasePart") and v or v:FindFirstAncestorWhichIsA("Model")
                    if m then
                        m:SetAttribute("ESP_Type", "Respawn")
                        CreateESP_Model(m, ESP_Colors.Respawn, "🔄 RESPAWN")
                    end
                end
            end
        end

        -- Objetos especiales
        if ESP_Active.GroundBulb or ESP_Active.Vine then
            for _,v in ipairs(MapFolder:GetDescendants()) do
                if v.Name == "GroundBulbModel" and ESP_Active.GroundBulb then
                    v:SetAttribute("ESP_Type", "GroundBulb")
                    CreateESP_Model(v, ESP_Colors.GroundBulb, "💡 BOMBILLA")
                elseif v.Name == "VineModel" and ESP_Active.Vine then
                    v:SetAttribute("ESP_Type", "Vine")
                    CreateESP_Model(v, ESP_Colors.Vine, "🌿 ENREDADERA")
                end
            end
        end
    end
end)

