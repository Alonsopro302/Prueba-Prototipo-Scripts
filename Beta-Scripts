local function TeleportToMap()
    local map = GetMap()
    local character = LocalPlayer.Character

    if not map or not character then
        Notify("No map to teleport to.")
        return
    end

    local spawnsFolder = map:FindFirstChild("Spawns")

    if not spawnsFolder then
        Notify("No map spawns found.")
        return
    end

    local spawns = spawnsFolder:GetChildren()

    if #spawns == 0 then
        Notify("No map spawns found.")
        return
    end

    local randomSpawn = spawns[math.random(1, #spawns)]

    if randomSpawn:IsA("BasePart") then
        character:MoveTo(randomSpawn.Position)
    elseif randomSpawn:IsA("Model") then
        character:PivotTo(randomSpawn:GetPivot())
    end
end

local function TeleportToDroppedGun()
    local map = GetMap()
    local character = LocalPlayer.Character
    local gunDrop = map and map:FindFirstChild("GunDrop")

    if not gunDrop or not character then
        Notify("No dropped gun to be teleported to.")
