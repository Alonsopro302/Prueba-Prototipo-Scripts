        text.Name = "TextLabel"
        text.Size = UDim2.fromScale(1, 1)
        text.BackgroundTransparency = 1
        text.TextScaled = true
        text.TextWrapped = true
        text.Font = Enum.Font.SourceSansBold
        text.TextColor3 = color
        text.Text = data.LabelText or "Objetivo"
        text.Parent = label
        Instance.new("UIStroke").Parent = text
    end
    self.Indicators[target] = {
        Highlight = highlight,
        Arrow = arrow,
        ArrowScale = arrowScale,
        DistanceLabel = distanceLabel,
        Label = label,
        Data = data
    }
    if data.GroupName then
        local group = self:AddGroup(data.GroupName)
        table.insert(group.targets, target)
        if not group.enabled then
            highlight.Enabled = false
            if arrow then arrow.Visible = false end
            if label then label.Enabled = false end
        end
    end
end
function ESP:Remove(target)
    local indicator = self.Indicators[target]
    if not indicator then return end
    if indicator.Highlight then indicator.Highlight:Destroy() end
    if indicator.Arrow then indicator.Arrow:Destroy() end
    if indicator.Label then indicator.Label:Destroy() end
    for _, group in pairs(self.Groups) do
        for i = #group.targets, 1, -1 do
            if group.targets[i] == target then table.remove(group.targets, i) end
        end
    end
    self.Indicators[target] = nil
end
function ESP:RemoveGroup(name)
    local group = self.Groups[name]
    if not group then return end
    local targets = table.clone(group.targets)
    for _, t in ipairs(targets) do self:Remove(t) end
    self.Groups[name] = nil
end
function ESP:ClearAllGroups()
    local list = {}
    for n in pairs(self.Groups) do table.insert(list, n) end
    for _, n in ipairs(list) do self:RemoveGroup(n) end
end
function ESP:Update()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local viewport = cam.ViewportSize
    local padding = 50
    for target, ind in pairs(self.Indicators) do
        if ind.Arrow and ind.ArrowScale then
            local pos
            if target:IsA("Model") then
                pos = target.PrimaryPart and target.PrimaryPart.Position or target:GetPivot().Position
            elseif target:IsA("BasePart") then
                pos = target.Position
            end
            if pos then
                local scr, vis = cam:WorldToViewportPoint(pos)
                local dist = (cam.CFrame.Position - pos).Magnitude
                if vis and dist > (ind.Data and ind.Data.ArrowMinDistance or 0) then
                    ind.ArrowScale.Scale = 0
                else
                    local center = Vector2.new(viewport.X/2, viewport.Y/2)
                    local dirSpc = cam.CFrame:VectorToObjectSpace(pos - cam.CFrame.Position)
                    local flat = Vector2.new(dirSpc.X, dirSpc.Y)
                    if flat.Magnitude > 0 then
                        flat = flat.Unit
                        local w = math.max(viewport.X - padding*2, 1)
                        local h = math.max(viewport.Y - padding*2, 1)
                        local offset
                        if math.abs(flat.Y) > h / math.max(w, 1) then
                            offset = flat * math.abs((h/2)/math.max(math.abs(flat.Y), 0.001))
                        else
                            offset = flat * math.abs((w/2)/math.max(math.abs(flat.X), 0.001))
                        end
                        ind.Arrow.Position = UDim2.fromOffset(center.X+offset.X, center.Y-offset.Y)
                        ind.Arrow.Rotation = math.deg(math.atan2(flat.X, flat.Y))
                        ind.ArrowScale.Scale = 1
                        if ind.DistanceLabel then
                            ind.DistanceLabel.Text = string.format("%dm", math.round(dist))
                        end
                    end
                end
            end
        end
    end
end
